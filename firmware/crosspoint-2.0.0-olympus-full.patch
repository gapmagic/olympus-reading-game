+void OlympusActivity::back() {
+  // Back from a profile always lands in the temple, on that character's cell, even when the
+  // profile was opened from the hatch screen (in the app or over the reader).
+  if (current() == Screen::Profile) {
+    stack.pop_back();
+    if (!stack.empty() && stack.back() == Screen::Hatch) stack.pop_back();
+    if (stack.empty() || stack.back() != Screen::Temple) stack.push_back(Screen::Temple);
+    templeTab = static_cast<int>(olympus::tierOf(profileId));
+    templeIndex = olympus::indexInTier(profileId);
+    requestUpdate();
+    return;
+  }
+  if (overReader) {
+    if (tierScreenPending && current() != Screen::TierComplete) {
+      tierScreenPending = false;
+      stack.assign(1, Screen::TierComplete);
+      requestUpdate();
+      return;
+    }
+    finish();
+    return;
+  }
+  stack.pop_back();
+  if (stack.empty()) {
+    activityManager.goHome(HomeMenuItem::OLYMPUS);
+    return;
+  }
+  requestUpdate();
+}
