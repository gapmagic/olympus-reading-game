+
+void ReaderActivity::noteOlympusPage(const bool atEnd) {
+  const int pages = olympusBookPages();
+  int startBp = 0;
+  int endBp = 0;
+  if (pages <= 0) return;
+  if (atEnd) {
+    startBp = 10000;
+    endBp = 10000;
+  } else if (!olympusPageSpan(startBp, endBp)) {
+    return;
+  }
+  auto& game = olympus::store();
+  game.beginBook(bookPath, pages);
+  if (game.notePage(startBp, endBp, endBp >= olympus::HATCH_AT_BP)) olympusHatchPending.store(true, std::memory_order_release);
+}
+
+// The hatch screen opens over the book; Back returns to the same page.
+bool ReaderActivity::openOlympusHatch() {
+  if (!olympusHatchPending.exchange(false, std::memory_order_acq_rel)) return false;
+  auto& game = olympus::store();
+  const olympus::HatchEvent event = game.pendingHatch();
+  game.clearPendingHatch();
+  if (!event.hatched) return false;
+  auto overlay = makeUniqueNoThrow<OlympusActivity>(renderer, mappedInput, event);
+  if (!overlay) {
+    LOG_ERR("READER", "OOM: Olympus hatch screen");
+    return false;
+  }
+  startActivityForResult(std::move(overlay), [this](const ActivityResult&) {
+    applyInitialOrientation();
+    requestUpdate();
+  });
+  return true;
+}
 
