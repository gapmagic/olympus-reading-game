+#pragma once
+// Device side of the Olympus game: owns the saved state on the SD card, the
+// local clock and the page log of the book being read.
+//
+// Files (all under /.crosspoint/olympus, never inside a book's cache folder, so
+// "Clear reading cache" keeps the collection):
+//   state.bin             collection, incubator and companion
+//   pages/<hash>.bin      game pages already read in one book
+#include <string>
+
+#include "OlympusRules.h"
+
+namespace olympus {
+
+class Store {
+ public:
+  State& state() {
+    ensureLoaded();
+    return data;
+  }
+  void save();
+
+  // Local day number (days since 1970-01-01) or NO_DAY when the clock is unknown.
+  static int32_t today();
+  // year * 12 + month, or -1 when the clock is unknown.
+  static int32_t month();
+
+  bool isColdEgg(int slot);
+  // "2 trứng đang ấp · 12/90 nhân vật"
+  std::string homeSummary();
+  bool hasFresh() { return state().anyFresh(); }
+
+  // Game pages of a book file (loads EPUB metadata or the XTC header). 0 on failure.
+  static int pagesForBook(const std::string& path);
+  // startBp: how far the book was already read (basis points, 0-10000); those pages count for the egg.
+  PlaceResult placeBook(const std::string& path, int pages, int startBp = 0, int* slotOut = nullptr);
+  bool discardSlot(int slot);
+
+  // Reader hooks. beginBook() is cheap to call repeatedly.
+  void beginBook(const std::string& path, int pages);
+  // Returns true when this page hatched an egg; the event is kept in pendingHatch().
+  bool notePage(int startBp, int endBp, bool atLastPage);
+  void flushBook();
+  const HatchEvent& pendingHatch() const { return hatch; }
+  void clearPendingHatch() { hatch = HatchEvent{}; }
+
+  void markSeen(uint8_t id);
+  void setSleepChar(uint8_t id);
+  void chooseCompanion(uint8_t id);
+  // Rolls the companion's day over and saves when it changed.
+  void refreshDay();
+
+ private:
+  void ensureLoaded();
+  void flushLog();
+  static std::string logPath(const std::string& bookPath);
+
+  State data;
+  bool loaded = false;
+
+  std::string bookPath;
+  int bookPages = 0;
+  bool tracking = false;
+  bool logDirty = false;
+  int unsavedPages = 0;
+  bool stateDirty = false;
+  PageLog log;
+  HatchEvent hatch;
+};
+
+Store& store();
+
+}  // namespace olympus
