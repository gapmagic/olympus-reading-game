+void OlympusActivity::renderProfile() {
+  const auto& s = olympus::store().state();
+  const uint8_t id = profileId;
+  const Tier tier = olympus::tierOf(id);
+  const olympus::Character& ch = olympus::character(id);
+  const bool hatched = s.isHatched(id);
+  const std::string num = draw::number(id);
+  renderer.drawText(UI_10_FONT_ID, 24, 14, num.c_str(), true, EpdFontFamily::BOLD);
+  const std::string kind = std::string(draw::tierUpperName(tier)) + OLY_T(" · ", " · ") +
+                           (tier == Tier::Clay ? OLY_T("SINH VẬT", "CREATURE") : (tier == Tier::Silver ? OLY_T("THẦN OLYMPUS", "OLYMPIAN GOD") : "TITAN"));
+  const int kw = renderer.getTextWidth(SMALL_FONT_ID, kind.c_str(), EpdFontFamily::BOLD);
+  renderer.drawText(SMALL_FONT_ID, W - 24 - kw, 16, kind.c_str(), true, EpdFontFamily::BOLD);
+  draw::meander(renderer, 44, 20, W - 20);
+
+  if (!hatched) {
+    draw::silhouette(renderer, (W - 256) / 2, 80, 256);
+    draw::centered(renderer, NOTOSANS_18_FONT_ID, W / 2, 360, "???", true, true);
+    draw::centered(renderer, SMALL_FONT_ID, W / 2, 412, OLY_T("Chưa nở", "Not hatched yet"));
+    renderer.drawRoundedRect(28, 440, W - 56, 130, 2, 10, true);
+    renderer.drawText(SMALL_FONT_ID, 44, 452, OLY_T("GỢI Ý", "HINT"), true, EpdFontFamily::BOLD);
+    draw::wrap(renderer, UI_10_FONT_ID, 44, 476, W - 88, (std::string(OLY_T("“", "\"")) + ch.hint + OLY_T("”", "\"")).c_str(), 3);
+    char buf[200];
+    const int missing = PER_TIER - s.hatchedCount(tier);
+    snprintf(buf, sizeof(buf), OLY_T("Nở từ %s (%s, %s). Bạn còn %d nhân vật chưa gặp ở bậc này.", "Hatches from a %s (%s, %s). %d characters in this tier still to meet."), draw::tierEggName(tier),
+             draw::tierBookName(tier), draw::tierBookRange(tier), missing);
+    draw::wrap(renderer, SMALL_FONT_ID, 28, 594, W - 56, buf, 3);
+    drawHints(OLY_T("Quay lại", "Back"), "", OLY_T("Trước", "Prev"), "Sau");
+    return;
+  }
+
+  draw::character(renderer, id, (W - 256) / 2, 64, 256);
+  draw::centered(renderer, olympus::fonts::TITLE, W / 2, 316, ch.name, true, true);
+  const std::string sub = std::string(draw::tierKind(tier)) + OLY_T(" · ", " · ") + draw::tierEggName(tier);
+  draw::centered(renderer, SMALL_FONT_ID, W / 2, 366, sub.c_str());
+
+  int y = 396;
+  const auto section = [this, &y](const char* label, const char* text, const int lines) {
+    renderer.drawText(SMALL_FONT_ID, 24, y, label, true, EpdFontFamily::BOLD);
+    y = draw::wrap(renderer, SMALL_FONT_ID, 24, y + renderer.getLineHeight(SMALL_FONT_ID), W - 48, text, lines) + 6;
+  };
+  section(OLY_T("XUẤT THÂN", "ORIGIN"), ch.origin, 2);
+  section(OLY_T("KHẢ NĂNG", "POWERS"), ch.ability, 2);
+  section(OLY_T("BIỂU TƯỢNG", "SYMBOLS"), ch.symbols, 1);
+  section(OLY_T("THẦN THOẠI", "MYTH"), ch.myth, 4);
+  if (hatched && ch.blessing[0]) {
+    section(tier == Tier::Clay ? OLY_T("LỜI NHẮN", "IN THEIR WORDS") : OLY_T("LỜI BAN PHƯỚC", "BLESSING"), ch.blessing, 2);
+  }
+
+  const char* action = s.companion.charId == id ? OLY_T("Đang ở màn chờ", "On sleep screen") : OLY_T("Đặt làm màn chờ", "Set as sleep screen");
+  drawHints(OLY_T("Quay lại", "Back"), action, OLY_T("Trước", "Prev"), "Sau");
+}
