+void goalPanel(const GfxRenderer& r, const State& s, const int y) {
+  const Companion& c = s.companion;
+  const Tier tier = tierOf(c.charId);
+  const int goal = dailyGoal(tier);
+  constexpr int H = 122;
+  r.drawRoundedRect(28, y, W - 56, H, 2, 10, true);
+  r.drawText(F::SMALL, 44, y + 14, OLY_T("MỤC TIÊU HÔM NAY", "TODAY'S GOAL"), true, EpdFontFamily::BOLD);
+  char buf[96];
+  snprintf(buf, sizeof(buf), OLY_T("%d/%d trang", "%d/%d pages"), std::min<int>(c.todayPages, 999), goal);
+  const int bw = r.getTextWidth(F::BUTTON, buf, EpdFontFamily::BOLD);
+  r.drawText(F::BUTTON, W - 44 - bw, y + 6, buf, true, EpdFontFamily::BOLD);
+  bar(r, 44, y + 44, W - 88, 14, c.todayPages * 1000 / goal);
+  snprintf(buf, sizeof(buf), OLY_T("Chỉ tính %s (%s)", "Only %s count (%s)"), tierBookName(tier), tierBookRange(tier));
+  r.drawText(F::SMALL, 44, y + 64, buf);
+  const char* missedLabel = OLY_T("Ngày lỡ", "Missed days");
+  r.drawText(F::SMALL, 44, y + 90, missedLabel, true, EpdFontFamily::BOLD);
+  const int dotsX = 44 + r.getTextWidth(F::SMALL, missedLabel, EpdFontFamily::BOLD) + 18;
+  const int missed = c.goalMetToday ? 0 : c.missed;
+  for (int i = 0; i < MAX_MISSED_DAYS; ++i) {
+    const int cx = dotsX + i * 22, cy = y + 102;
+    if (i < missed) {
+      fillCircle(r, cx, cy, 7);
+    } else {
+      ring(r, cx, cy, 7, 2);
+    }
+  }
+  if (tier == Tier::Clay) {
+    snprintf(buf, sizeof(buf), OLY_T("Chuỗi nuôi: %d ngày", "Fed streak: %d days"), c.streak);
+  } else if (c.ember) {
+    snprintf(buf, sizeof(buf), OLY_T("Đuốc: than tàn", "Torch: embers"));
+  } else {
+    snprintf(buf, sizeof(buf), OLY_T("Đuốc cháy %d ngày", "Torch lit %d days"), c.streak);
+  }
+  singularDays(buf);
+  const int sw = r.getTextWidth(F::SMALL, buf, EpdFontFamily::BOLD);
+  r.drawText(F::SMALL, W - 44 - sw, y + 90, buf, true, EpdFontFamily::BOLD);
+}
+
+// A white box for quotes and news, or a black one for warnings, under the scene.
+// Lines are centred. Returns the y below the box.
+int message(const GfxRenderer& r, const int y, const char* text, const bool warning) {
+  const auto style = warning ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR;
+  const auto lines = r.wrappedText(F::BODY, text, W - 96, 4, style);
+  const int lh = r.getLineHeight(F::BODY);
+  const int h = static_cast<int>(lines.size()) * lh + 22;
+  if (warning) {
+    r.fillRoundedRect(28, y, W - 56, h, 12, Color::Black);
+  } else {
+    r.drawRoundedRect(28, y, W - 56, h, 2, 12, true);
+  }
+  int yy = y + 11;
+  for (const auto& line : lines) {
+    centered(r, F::BODY, W / 2, yy, line.c_str(), !warning, warning);
+    yy += lh;
+  }
+  return y + h;
+}
