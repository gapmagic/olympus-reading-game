+bool EpubReaderActivity::olympusPageSpan(int& startBp, int& endBp) const {
+  if (!epub || !section || epub->getBookSize() == 0) return false;
+  const int total = section->estimatedTotalPages();
+  if (total <= 0) return false;
+  const int page = std::clamp(static_cast<int>(section->currentPage), 0, total - 1);
+  const auto toBp = [this](const float chapterFraction) {
+    const float book = std::clamp(epub->calculateProgress(currentSpineIndex, chapterFraction), 0.0f, 1.0f);
+    return static_cast<int>(book * 10000.0f + 0.5f);
+  };
+  startBp = toBp(static_cast<float>(page) / static_cast<float>(total));
+  const bool lastPage = currentSpineIndex == epub->getSpineItemsCount() - 1 && !section->isBuilding() &&
+                        !section->isPartial() && page >= total - 1;
+  endBp = lastPage ? 10000 : toBp(static_cast<float>(page + 1) / static_cast<float>(total));
+  return true;
+}
