+void OlympusActivity::renderIncubator() {
+  auto& st = olympus::store();
+  const auto& s = st.state();
+  renderer.drawText(olympus::fonts::TITLE, 24, 16, OLY_T("Lò ấp", "Incubator"), true, EpdFontFamily::BOLD);
+  renderer.drawText(SMALL_FONT_ID, 24, 66, OLY_T("Chỉ trang đọc trong 3 cuốn này mới làm trứng nứt", "Only pages read in these 3 books crack the eggs"));
+  const int32_t today = olympus::Store::today();
+  for (int i = 0; i < olympus::SLOT_COUNT; ++i) {
+    const auto& slot = s.slots[i];
+    const int y = 96 + i * 220;
+    const bool selected = i == incubatorSelected;
+    if (!slot.used) {
+      dashedRect(renderer, 24, y, W - 48, 206);
+      if (selected) renderer.drawRoundedRect(20, y - 4, W - 40, 214, 2, 10, true);
+      draw::centered(renderer, NOTOSANS_18_FONT_ID, W / 2, y + 50, "+", true, true);
+      draw::centered(renderer, UI_10_FONT_ID, W / 2, y + 110, OLY_T("Ô trống · Đặt sách vào lò ấp", "Empty slot · Add a book"), true, true);
+      draw::centered(renderer, SMALL_FONT_ID, W / 2, y + 140,
+                     mappedInput.hasTouch() ? OLY_T("Chạm để mở Thư viện, rồi nhấn giữ một cuốn sách", "Tap to open the Library, then long-press a book")
+                                            : OLY_T("Bấm OK để mở Thư viện, rồi giữ OK trên một cuốn", "Press OK to open the Library, then hold OK on a book"));
+      continue;
+    }
+    renderer.drawRoundedRect(24, y, W - 48, 206, selected ? 4 : 2, 10, true);
+    const bool cold = st.isColdEgg(i);
+    draw::egg(renderer, slot.tier, olympus::crackStage(slot.readPages, slot.pages), cold, 36, y + 13, 180);
+    const int x = 226;
+    draw::pill(renderer, SMALL_FONT_ID, x, y + 14, draw::tierUpperName(slot.tier));
+    const std::string title = renderer.truncatedText(UI_12_FONT_ID, bookTitle(slot.path).c_str(), W - 48 - x - 12,
+                                                     EpdFontFamily::BOLD);
+    renderer.drawText(UI_12_FONT_ID, x, y + 46, title.c_str(), true, EpdFontFamily::BOLD);
+    char line[96];
+    snprintf(line, sizeof(line), OLY_T("%d trang", "%d pages"), slot.pages);
+    renderer.drawText(SMALL_FONT_ID, x, y + 78, line);
+    draw::bar(renderer, x, y + 102, W - 48 - x - 16, 18, slot.pages ? slot.readPages * 1000 / slot.pages : 0);
+    snprintf(line, sizeof(line), OLY_T("%d%%  ·  trang %d/%d", "%d%%  ·  page %d/%d"), slot.pages ? slot.readPages * 100 / slot.pages : 0,
+             slot.readPages, slot.pages);
+    renderer.drawText(UI_10_FONT_ID, x, y + 132, line, true, EpdFontFamily::BOLD);
+    if (cold) {
+      snprintf(line, sizeof(line), OLY_T("Trứng nguội: %d ngày chưa đọc", "Cold egg: not read for %d days"), static_cast<int>(today - slot.lastReadDay));
+    } else if (slot.charId == NO_CHAR) {
+      snprintf(line, sizeof(line), OLY_T("Đã đủ bộ: trứng này không nở ra gì", "Set complete: this egg will hatch nothing"));
+    } else {
+      const int stage = olympus::crackStage(slot.readPages, slot.pages);
+      const int nextAt = stage >= 3 ? slot.pages : (slot.pages * (stage + 1) * 25 + 99) / 100;
+      snprintf(line, sizeof(line), stage >= 3 ? OLY_T("Còn %d trang để nở", "%d pages to hatch") : OLY_T("Còn %d trang tới vết nứt", "%d pages to the next crack"),
+               std::max(0, nextAt - slot.readPages));
+    }
+    draw::wrap(renderer, SMALL_FONT_ID, x, y + 162, W - 48 - x - 12, line, 2);
+  }
+  drawHints(OLY_T("Quay lại", "Back"), s.slots[incubatorSelected].used ? OLY_T("Đọc tiếp", "Keep reading") : OLY_T("Thư viện", "Library"), OLY_T("Lên", "Up"), OLY_T("Xuống", "Down"));
+}
