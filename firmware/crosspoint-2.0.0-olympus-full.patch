+void label(const GfxRenderer& r, const char* text) {
+  // Between the facade columns; long names step down a size.
+  const int font = r.getTextWidth(F::LABEL, text, EpdFontFamily::BOLD) > 372 ? F::LABEL_SMALL : F::LABEL;
+  centered(r, font, W / 2, ENTABLATURE + 8, text, true, true);
+}
+
+void phase1Screen(const GfxRenderer& r, const State& s) {
+  const uint8_t id = s.sleepChar;
+  if (id != NO_CHAR && s.isHatched(id)) {
+    character(r, id, (W - 288) / 2, 150, 288);
+    centered(r, F::TITLE, W / 2, 448, olympus::character(id).name, true, true);
+    const std::string sub = number(id) + " · " + tierEggName(tierOf(id));
+    centered(r, F::BODY, W / 2, 504, sub.c_str());
+    return;
+  }
+  centered(r, F::TITLE, W / 2, 150, OLY_T("Lò ấp", "Incubator"), true, true);
+  centered(r, F::BODY, W / 2, 204, OLY_T("Chưa có nhân vật nào nở", "No character has hatched yet"));
+  incubatorRow(r, s, 260, true);
+  wrap(r, F::BODY, 48, 420, W - 96,
+       OLY_T("Đọc xong một cuốn trong lò ấp để nở nhân vật đầu tiên. Sau đó vào Đền thờ để chọn nhân vật cho màn hình chờ.", "Finish a book in the incubator to hatch your first character. Then visit the Temple to choose one for your sleep screen."),
+       4);
+}
+
+void leftScreen(const GfxRenderer& r, const State& s) {
+  // The creature went back to the temple: tipped bowl, cracked stone, faded figure.
+  const uint8_t id = s.companion.leftCharId;
+  const char* name = olympus::character(id).name;
+  char buf[240];
+  facade(r, SCENE_BOTTOM);
+  snprintf(buf, sizeof(buf), OLY_T("%s đã về Đền thờ", "%s went back to the Temple"), name);
+  label(r, buf);
+  altar(r, id, 2);
+  snprintf(buf, sizeof(buf), OLY_T("%d ngày liền chưa đọc đủ %d trang nên %s đã về Đền thờ. Vào Đền thờ để chọn lại %s nhé.", "%d days in a row without reading %d pages, so %s went back to the Temple. Visit the Temple to choose %s again."),
+           MAX_MISSED_DAYS, dailyGoal(Tier::Clay), name, name);
+  const int below = message(r, SCENE_BOTTOM + 18, buf, false);
+  // Big button, centred in the space between the message and the bottom border.
+  const char* wake = OLY_T("Bật máy · vào Đền thờ", "Wake up · visit the Temple");
+  const int tw = r.getTextWidth(F::BUTTON, wake, EpdFontFamily::BOLD);
+  const int bh = r.getLineHeight(F::BUTTON) + 16, bw = tw + 48;
+  const int by = below + (760 - below - bh) / 2;
+  r.fillRoundedRect((W - bw) / 2, by, bw, bh, bh / 2, Color::Black);
+  r.drawText(F::BUTTON, (W - tw) / 2, by + 8, wake, false, EpdFontFamily::BOLD);
+}
+
+void companionScreen(const GfxRenderer& r, const State& s) {
+  const Companion& c = s.companion;
+  const Character& ch = olympus::character(c.charId);
+  const Tier tier = tierOf(c.charId);
+  const Mood mood = companionMood(s);
+  const int goal = dailyGoal(tier);
+  char top[96];
+  char text[320];
+  bool warning = false;
+  switch (mood) {
+    case Mood::Happy:
+      snprintf(top, sizeof(top), c.todayPages >= goal ? OLY_T("%s đang chơi đùa", "%s is playing") : OLY_T("%s đang chờ bữa ăn", "%s is waiting for a meal"), ch.name);
+      break;
+    case Mood::Hungry:
+      snprintf(top, sizeof(top), OLY_T("%s đói bụng", "%s is hungry"), ch.name);
+      break;
+    case Mood::Blessing:
+      snprintf(top, sizeof(top), OLY_T("Đuốc của %s đang cháy", "%s's torch is burning"), ch.name);
+      break;
+    case Mood::WeakTorch:
+      snprintf(top, sizeof(top), OLY_T("Đuốc của %s cháy yếu", "%s's torch is burning low"), ch.name);
+      break;
+    default:
+      snprintf(top, sizeof(top), OLY_T("Đuốc của %s đã thành than", "%s's torch has burned out"), ch.name);
+      break;
+  }
+  facade(r, SCENE_BOTTOM);
+  label(r, top);
+
+  if (tier == Tier::Clay) {
+    const bool fed = c.todayPages >= goal;
+    altar(r, c.charId, fed ? 0 : 1);
+    if (fed) {
+      snprintf(text, sizeof(text), OLY_T("“%s”", "“%s”"), ch.blessing);
+    } else if (mood == Mood::Hungry) {
+      warning = true;
+      const int left = MAX_MISSED_DAYS - c.missed;
+      if (left > 1) {
+        snprintf(text, sizeof(text), OLY_T("Đã lỡ %d ngày. Còn %d ngày để đọc %d trang %s, nếu không %s sẽ về đền.", "Days missed: %d. You have %d days to read %d pages of %s, or %s will go back to the Temple."),
+                 c.missed, left, goal, tierBookRead(tier), ch.name);
+      } else {
+        snprintf(text, sizeof(text), OLY_T("Đã lỡ %d ngày. Hôm nay đọc %d trang %s, nếu không %s sẽ về đền.", "Days missed: %d. Read %d pages of %s today, or %s will go back to the Temple."),
+                 c.missed, goal, tierBookRead(tier), ch.name);
+      }
+    } else {
+      snprintf(text, sizeof(text), OLY_T("Hôm nay %s chưa được ăn. Đọc đủ %d trang để cho nó ăn nhé.", "%s hasn't eaten today. Read %d pages to feed it."), ch.name, goal);
+    }
+  } else {
+    const int level = mood == Mood::Ember ? 0 : (mood == Mood::WeakTorch ? 1 : 2);
+    shrine(r, c.charId, level);
+    if (mood == Mood::Ember) {
+      warning = true;
+      snprintf(text, sizeof(text), OLY_T("%s đang giận. Đọc %d trang %s để thắp lại đuốc.", "%s is angry. Read %d pages of %s to relight the torch."), ch.name, goal,
+               tierBookRead(tier));
+    } else if (mood == Mood::WeakTorch) {
+      warning = true;
+      snprintf(text, sizeof(text), OLY_T("Đã lỡ %d ngày. Hôm nay đọc %d trang %s, nếu không đuốc sẽ thành than.", "Days missed: %d. Read %d pages of %s today, or the torch will burn out."),
+               c.missed, goal, tierBookRead(tier));
+    } else {
+      snprintf(text, sizeof(text), "“%s”", ch.blessing);
+    }
+  }
+  const int below = message(r, SCENE_BOTTOM + 18, text, warning);
+  goalPanel(r, s, below + 12);
+  if (Store::today() == NO_DAY) {
+    centered(r, F::SMALL, W / 2, 738, OLY_T("Đồng hồ chưa có giờ: chưa đếm được ngày", "Clock not set: days cannot be counted yet"));
+  }
+}
+}  // namespace
+
+void statusScreen(const GfxRenderer& r, const bool forSleep) {
+  (void)forSleep;
+  Store& st = store();
+  st.refreshDay();
+  const State& s = st.state();
+  frame(r);
+  // The companion screen (feeding / torch) shows in both phases once a character is on the sleep screen.
+  if (s.companion.charId != NO_CHAR) {
+    companionScreen(r, s);
+  } else if (s.companion.leftCharId != NO_CHAR) {
+    leftScreen(r, s);
+  } else if (!s.phase2()) {
+    phase1Screen(r, s);
+  } else {
+    centered(r, F::TITLE, W / 2, 300, OLY_T("Đã đủ 90/90", "All 90/90 collected"), true, true);
+    wrap(r, F::BODY, 60, 370, W - 120,
+         OLY_T("Lò ấp đã đóng. Vào Olympus, mở hồ sơ một nhân vật trong Đền thờ và chạm Đặt làm màn chờ để nhận bạn đồng hành.", "The Incubator is closed. Open Olympus, open a character profile in the Temple and tap Set as sleep screen to get a companion."), 4);
+  }
+}
+
+}  // namespace olympus::draw
diff --git a/src/olympus/OlympusDraw.h b/src/olympus/OlympusDraw.h
new file mode 100644
index 00000000..7f722c5e
--- /dev/null
+++ b/src/olympus/OlympusDraw.h
@@ -0,0 +1,45 @@
+#pragma once
+// Drawing helpers shared by the Olympus screens and the sleep screen.
+#include <cstdint>
+#include <string>
+
+#include "OlympusRules.h"
+#include "OlympusSprite.h"
+
+class GfxRenderer;
+
+namespace olympus::draw {
+
+// 4-tone sprite scaled (nearest neighbour) into a size x size square; grays
+// are dithered, white is transparent.
+void sprite(const GfxRenderer& r, const Sprite& s, int x, int y, int size);
+// Character art, or a placeholder figure when the character has no art yet.
+void character(const GfxRenderer& r, uint8_t id, int x, int y, int size);
+// Dark "?" figure for a character not hatched yet.
+void silhouette(const GfxRenderer& r, int x, int y, int size);
+void egg(const GfxRenderer& r, Tier tier, int stage, bool cold, int x, int y, int size);
+void logo(const GfxRenderer& r, int x, int y, int size);
+// Greek key band, 10 px high.
+void meander(const GfxRenderer& r, int y, int x0, int x1);
+// Progress bar with quarter ticks; frac in 0..1000 per mille.
+void bar(const GfxRenderer& r, int x, int y, int w, int h, int perMille);
+// Black rounded label with white text; returns its width.
+int pill(const GfxRenderer& r, int fontId, int x, int y, const char* text, bool inverted = false);
+// Word-wrapped text; returns the y below the last line.
+int wrap(const GfxRenderer& r, int fontId, int x, int y, int w, const char* text, int maxLines, bool black = true,
+         bool bold = false);
+void centered(const GfxRenderer& r, int fontId, int cx, int y, const char* text, bool black = true, bool bold = false);
+
+const char* tierEggName(Tier tier);    // "Trứng đất sét"
+const char* tierUpperName(Tier tier);  // "TRỨNG ĐẤT SÉT"
+const char* tierShortName(Tier tier);  // "Đất sét"
+const char* tierKind(Tier tier);       // "Sinh vật", "Thần", "Titan"
+const char* tierBookRange(Tier tier);  // "tới 200 trang"
+const char* tierBookName(Tier tier);   // "sách mỏng" / "short books"
+const char* tierBookRead(Tier tier);   // "sách mỏng" / "a short book" (after "read N pages of")
+std::string number(uint8_t id);        // "#003"
+
+// The companion / incubator screen drawn on sleep and by the companion tile.
+void statusScreen(const GfxRenderer& r, bool forSleep);
+
+}  // namespace olympus::draw
