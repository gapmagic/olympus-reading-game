+
+#include "activities/Activity.h"
+#include "olympus/OlympusRules.h"
+
+// The Olympus reading game: hub, incubator, temple, character profiles, the
+// companion and the hatch screens. One activity with its own screen stack, so
+// Back always returns to the previous Olympus screen.
+class OlympusActivity final : public Activity {
+ public:
+  // Opened from Home.
+  OlympusActivity(GfxRenderer& renderer, MappedInputManager& mappedInput);
+  // Opened over the reader for a hatch; every Back returns to the book.
+  OlympusActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, const olympus::HatchEvent& hatch);
+
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
+  enum class Screen : uint8_t { Hub, Incubator, Temple, Profile, Hatch, TierComplete, Companion };
+
+  struct Modal {
+    bool active = false;
+    std::string title;
+    std::string body;
+    std::vector<std::string> options;
+    int selected = 0;
+    std::function<void(int)> onPick;
+  };
+
+  void push(Screen s);
+  void back();
+  Screen current() const { return stack.empty() ? Screen::Hub : stack.back(); }
+  void showModal(std::string title, std::string body, std::vector<std::string> options, int selected,
+                 std::function<void(int)> onPick);
+  void openProfile(uint8_t id);
+
+  // Touch boards (X4 Pro) have no front buttons: taps and swipes become virtual button events,
+  // read through these instead of MappedInputManager directly.
+  void routeTouch();
+  bool hitContent(int x, int y, bool hold);
+  bool released(MappedInputManager::Button b) const;
+  bool pressed(MappedInputManager::Button b) const;
+  bool heldLong(MappedInputManager::Button b) const;
+
+  void loopHub();
+  void loopIncubator();
+  void loopTemple();
+  void loopProfile();
+  void loopModal();
+
+  void renderHub();
+  void renderIncubator();
+  void renderTemple();
+  void renderProfile();
+  void renderHatch();
+  void renderTierComplete();
+  void renderModal();
+  void drawHints(const char* back, const char* confirm, const char* previous, const char* next);
+
+  bool overReader = false;
+  bool firstRender = true;
+  std::vector<Screen> stack;
+  Modal modal;
+
+  int hubSelected = 0;
+  int incubatorSelected = 0;
+  int templeTab = 0;
+  int templeIndex = 0;  // 0..29 within the tab
+  uint8_t profileId = 0;
+  olympus::HatchEvent hatch;
+  bool tierScreenPending = false;
+
+  // Virtual button produced by a tap this frame (-1 none), and a long-press on content.
+  int virtualButton = -1;
+  bool virtualHold = false;
+  // Tap rects recorded at render time: the on-screen button bar and the modal's options.
+  struct Rect {
+    int x = 0, y = 0, w = 0, h = 0;
+    bool contains(const int px, const int py) const { return w > 0 && px >= x && px < x + w && py >= y && py < y + h; }
+  };
+  Rect barRects[4];
+  std::vector<Rect> modalRects;
+};
