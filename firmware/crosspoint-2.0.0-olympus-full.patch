+OlympusActivity::OlympusActivity(GfxRenderer& renderer, MappedInputManager& mappedInput,
+                                 const olympus::HatchEvent& hatchEvent)
+    : Activity("Olympus", renderer, mappedInput), overReader(true), hatch(hatchEvent) {
+  stack.push_back(Screen::Hatch);
+  tierScreenPending = hatch.tierCompleted || hatch.allCompleted;
+  if (!hatch.empty) {
+    profileId = hatch.charId;
+    templeTab = static_cast<int>(hatch.tier);
+    templeIndex = olympus::indexInTier(hatch.charId);
+  }
