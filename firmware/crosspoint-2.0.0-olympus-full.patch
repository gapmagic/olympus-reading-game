+void OlympusActivity::renderHub() {
+  auto& st = olympus::store();
+  const auto& s = st.state();
+  const bool phase2 = s.phase2();
+  draw::logo(renderer, 24, 24, 64);
+  renderer.drawText(NOTOSANS_18_FONT_ID, 100, 30, "Olympus", true, EpdFontFamily::BOLD);
+  char sub[64];
+  snprintf(sub, sizeof(sub), phase2 ? OLY_T("%d/90 · Đã sưu tầm đủ", "%d/90 · Collection complete") : OLY_T("%d/90 nhân vật", "%d/90 characters"), s.totalHatched());
+  renderer.drawText(SMALL_FONT_ID, 100, 80, sub);
+  draw::meander(renderer, 108, 20, W - 20);
+
+  const auto tile = [this](const int y, const bool selected) {
+    renderer.drawRoundedRect(24, y, W - 48, 200, selected ? 4 : 2, 12, true);
+  };
+  // Tile 1: incubator or companion.
+  tile(130, hubSelected == 0);
+  if (!phase2) {
+    int shown = 0;
+    int best = -1;
+    for (int i = 0; i < olympus::SLOT_COUNT; ++i) {
+      const auto& slot = s.slots[i];
+      if (!slot.used) continue;
+      const int pct = slot.pages ? slot.readPages * 100 / slot.pages : 0;
+      best = std::max(best, pct);
+      if (shown < 2) {
+        draw::egg(renderer, slot.tier, olympus::crackStage(slot.readPages, slot.pages), st.isColdEgg(i),
+                  36 + shown * 80, 186, 80);
+        ++shown;
+      }
+    }
+    if (shown == 0) draw::egg(renderer, Tier::Clay, 0, false, 70, 186, 80);
+    renderer.drawText(NOTOSANS_18_FONT_ID, 210, 170, OLY_T("Lò ấp", "Incubator"), true, EpdFontFamily::BOLD);
+    char line[96];
+    if (best >= 0) {
+      snprintf(line, sizeof(line), OLY_T("%d/3 ô đang ấp · gần nở nhất %d%%", "%d/3 eggs incubating · closest to hatching %d%%"), s.usedSlots(), best);
+    } else {
+      snprintf(line, sizeof(line), OLY_T("Lò ấp đang trống", "Incubator is empty"));
+    }
+    draw::wrap(renderer, SMALL_FONT_ID, 210, 226, W - 250, line, 3);
+  } else {
+    const auto& c = s.companion;
+    if (c.charId != NO_CHAR) draw::character(renderer, c.charId, 40, 162, 128);
+    renderer.drawText(UI_12_FONT_ID, 190, 180, OLY_T("Bạn đồng hành", "Companion"), true, EpdFontFamily::BOLD);
+    char line[128];
+    if (c.charId == NO_CHAR) {
+      snprintf(line, sizeof(line), OLY_T("Chưa có. Vào Đền thờ để chọn một nhân vật.", "None yet. Visit the Temple to choose a character."));
+    } else {
+      const Tier tier = olympus::tierOf(c.charId);
+      snprintf(line, sizeof(line), OLY_T("%s · %s %d ngày · %d/%d trang", "%s · %s %d days · %d/%d pages"), olympus::character(c.charId).name,
+               tier == Tier::Clay ? OLY_T("nuôi", "fed") : (c.ember ? OLY_T("đuốc tàn,", "torch out,") : OLY_T("đuốc cháy", "torch lit")), c.streak, c.todayPages,
+               olympus::dailyGoal(tier));
+    }
+    draw::wrap(renderer, SMALL_FONT_ID, 190, 226, W - 230, line, 3);
+  }
+
+  // Tile 2: temple.
+  tile(350, hubSelected == 1);
+  draw::logo(renderer, 40, 390, 128);
+  renderer.drawText(NOTOSANS_18_FONT_ID, 190, 390, OLY_T("Đền thờ", "Temple"), true, EpdFontFamily::BOLD);
+  int freshCount = 0;
+  for (int i = 0; i < olympus::TOTAL_CHARACTERS; ++i) freshCount += s.isFresh(static_cast<uint8_t>(i)) ? 1 : 0;
+  char line[128];
+  if (phase2) {
+    snprintf(line, sizeof(line), OLY_T("Bộ sưu tập 90/90 · chọn bạn đồng hành", "Collection 90/90 · choose a companion"));
+  } else if (freshCount > 0) {
+    snprintf(line, sizeof(line), OLY_T("Bộ sưu tập · %d/90 · có %d nhân vật mới", "Collection · %d/90 · %d new"), s.totalHatched(), freshCount);
+  } else {
+    snprintf(line, sizeof(line), OLY_T("Bộ sưu tập · %d/90", "Collection · %d/90"), s.totalHatched());
+  }
+  const int y = draw::wrap(renderer, SMALL_FONT_ID, 190, 446, W - 230, line, 3);
+  if (freshCount > 0 && !phase2) draw::pill(renderer, SMALL_FONT_ID, 190, y + 8, OLY_T("MỚI", "NEW"));
+
+  renderer.drawRoundedRect(24, 580, W - 48, 100, 1, 8, true);
+  draw::wrap(renderer, SMALL_FONT_ID, 40, 594, W - 80,
+             phase2 ? OLY_T("Đã đủ 90 nhân vật nên Lò ấp đã đóng. Vào Đền thờ để đổi bạn đồng hành.", "All 90 characters collected, so the Incubator is closed. Visit the Temple to change companion.")
+                    : OLY_T("Muốn ấp thêm trứng: vào Thư viện (Library), tab Recent, giữ OK (hoặc nhấn giữ) trên một cuốn sách và chọn "
+                      "\"Đặt vào lò ấp\".", "To incubate another egg: open the Library, Recent tab, hold OK (or long-press) on a book and choose " "\"Put in incubator\"."),
+             4);
+  drawHints("Home", OLY_T("Mở", "Open"), OLY_T("Lên", "Up"), OLY_T("Xuống", "Down"));
+}
