+// "Olympus · 2 trứng · 12/90", with a dot while a new character waits to be seen.
+std::string HomeActivity::olympusMenuLabel() {
+  auto& game = olympus::store();
+  const auto& s = game.state();
+  std::string label = "Olympus";
+  if (s.phase2()) {
+    label += s.companion.charId != olympus::NO_CHAR ? std::string(OLY_T(" · ", " · ")) + olympus::character(s.companion.charId).name
+                                                     : std::string(OLY_T(" · 90/90", " · 90/90"));
+  } else {
+    label += OLY_T(" · ", " · ") + std::to_string(s.usedSlots()) + OLY_T(" trứng · ", " eggs · ") + std::to_string(s.totalHatched()) + "/90";
+  }
+  if (s.anyFresh()) label += "  \u2022";
+  return label;
+}
