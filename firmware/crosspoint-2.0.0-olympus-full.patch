+namespace {
+constexpr char DIR[] = "/.crosspoint/olympus";
+constexpr char PAGES_DIR[] = "/.crosspoint/olympus/pages";
+constexpr char STATE_FILE[] = "state.bin";
+// Save the page log after this many new pages even without leaving the book.
+constexpr int SAVE_EVERY_PAGES = 10;
+
+bool localNow(struct tm& out) {
+  if (halClock.localTime(out) && out.tm_year + 1900 >= 2025) return true;
+  const int64_t now = trustedtime::trustedNow();
+  if (now <= 0) return false;
+  const time_t t = static_cast<time_t>(now);
+  localtime_r(&t, &out);
+  return out.tm_year + 1900 >= 2025;
+}
+
+// Days from 1970-01-01 for a civil date (Howard Hinnant's algorithm).
+int32_t daysFromCivil(int y, const unsigned m, const unsigned d) {
+  y -= m <= 2;
+  const int era = (y >= 0 ? y : y - 399) / 400;
+  const unsigned yoe = static_cast<unsigned>(y - era * 400);
+  const unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + static_cast<int32_t>(doe) - 719468;
+}
+
+bool readWhole(const std::string& path, std::vector<uint8_t>& out, const size_t cap) {
+  HalFile file;
+  if (!Storage.openFileForRead("OLY", path, file)) return false;
+  const size_t size = file.fileSize();
+  if (size == 0 || size > cap) return false;
+  out.resize(size);
+  return file.read(out.data(), size) == static_cast<int>(size);
+}
+}  // namespace
+
+Store& store() {
+  static Store instance;
+  return instance;
+}
+
+int32_t Store::today() {
+  struct tm t{};
+  if (!localNow(t)) return NO_DAY;
+  return daysFromCivil(t.tm_year + 1900, static_cast<unsigned>(t.tm_mon + 1), static_cast<unsigned>(t.tm_mday));
+}
+
+int32_t Store::month() {
+  struct tm t{};
+  if (!localNow(t)) return -1;
+  return (t.tm_year + 1900) * 12 + t.tm_mon;
+}
+
+void Store::ensureLoaded() {
+  if (loaded) return;
+  loaded = true;
+  std::vector<uint8_t> bytes;
+  const std::string path = std::string(DIR) + "/" + STATE_FILE;
+  if (readWhole(path, bytes, STATE_BUFFER_SIZE)) {
+    if (!deserializeState(data, bytes.data(), bytes.size())) LOG_ERR("OLY", "state.bin unreadable, starting fresh");
+  }
+  data.rng ^= static_cast<uint32_t>(millis()) * 2654435761u ^ static_cast<uint32_t>(esp_random());
+}
+
+void Store::save() {
+  ensureLoaded();
+  auto buffer = makeUniqueNoThrow<uint8_t[]>(STATE_BUFFER_SIZE);
+  if (!buffer) {
+    LOG_ERR("OLY", "OOM: state buffer");
+    return;
+  }
+  const size_t len = serializeState(data, buffer.get(), STATE_BUFFER_SIZE);
+  if (len == 0) return;
+  Storage.mkdir(DIR);
+  if (!ProgressFile::writeAtomic(DIR, STATE_FILE, buffer.get(), len)) LOG_ERR("OLY", "could not save state");
+  stateDirty = false;
+}
+
+bool Store::isColdEgg(const int slot) {
+  const Slot& s = state().slots[slot];
+  const int32_t now = today();
+  return s.used && now != NO_DAY && s.lastReadDay != NO_DAY && now - s.lastReadDay >= COLD_EGG_DAYS;
+}
+
+std::string Store::homeSummary() {
+  const State& s = state();
+  const int total = s.totalHatched();
+  if (s.phase2()) {
+    if (s.companion.charId == NO_CHAR) return OLY_T("90/90 · chọn bạn đồng hành", "90/90 · choose a companion");
+    return std::string(character(s.companion.charId).name) + OLY_T(" · ", " · ") + std::to_string(s.companion.todayPages) + "/" +
+           std::to_string(dailyGoal(tierOf(s.companion.charId))) + OLY_T(" trang", " pages");
+  }
+  return std::to_string(s.usedSlots()) + OLY_T(" trứng đang ấp · ", " eggs incubating · ") + std::to_string(total) + OLY_T("/90 nhân vật", "/90 characters");
+}
+
+int Store::pagesForBook(const std::string& path) {
+  if (FsHelpers::hasXtcExtension(path)) {
+    auto xtc = makeUniqueNoThrow<Xtc>(path, "/.crosspoint");
+    if (!xtc || !xtc->load()) return 0;
+    return static_cast<int>(std::min<uint32_t>(xtc->getPageCount(), 60000));
+  }
+  if (!FsHelpers::hasReflowableBookExtension(path)) return 0;
+  auto epub = makeUniqueNoThrow<Epub>(path, "/.crosspoint");
+  if (!epub || !epub->load(true, true)) return 0;
+  const size_t bytes = epub->getBookSize();
+  return bytes > 0 ? pagesForEpubBytes(bytes) : 0;
+}
+
+PlaceResult Store::placeBook(const std::string& path, const int pages, const int startBp, int* slotOut) {
+  int slot = -1;
+  const PlaceResult result = olympus::placeBook(state(), path, pages, today(), &slot);
+  if (slotOut) *slotOut = slot;
+  if (result == PlaceResult::Placed || result == PlaceResult::PlacedEmpty) {
+    Storage.remove(logPath(path).c_str());
+    if (path == bookPath) tracking = false;
+    // The part of the book already read counts for the egg: start its page log there.
+    if (startBp > 0 && slot >= 0) {
+      PageLog start;
+      start.reset(pages);
+      start.markSpan(0, std::min(startBp, 10000));
+      state().slots[slot].readPages = static_cast<uint16_t>(std::min(start.readCount(), pages));
+      Storage.mkdir(PAGES_DIR);
+      const std::vector<uint8_t> bytes = start.serialize();
+      const std::string file = logPath(path);
+      const auto slash = file.rfind('/');
+      if (!ProgressFile::writeAtomic(file.substr(0, slash), file.substr(slash + 1).c_str(), bytes.data(), bytes.size())) {
+        LOG_ERR("OLY", "could not save start page log");
+      }
+    }
+    save();
+  }
+  return result;
+}
+
+bool Store::discardSlot(const int slot) {
+  if (!olympus::discardSlot(state(), slot, month())) return false;
+  save();
+  return true;
+}
+
+std::string Store::logPath(const std::string& path) {
+  return std::string(PAGES_DIR) + "/" + std::to_string(std::hash<std::string>{}(path)) + ".bin";
+}
+
+void Store::beginBook(const std::string& path, const int pages) {
+  if (path == bookPath && pages == bookPages && tracking) return;
+  flushBook();
+  bookPath = path;
+  bookPages = pages;
+  State& s = state();
+  tracking = pages > 0 && (s.slotForPath(path) >= 0 || isCompanionBook(s, pages));
+  if (!tracking) return;
+  std::vector<uint8_t> bytes;
+  if (!readWhole(logPath(path), bytes, 8 + 60000 / 8) || !log.deserialize(bytes.data(), bytes.size()) ||
+      log.pages() != pages) {
+    log.reset(pages);
+  }
+  const int slot = s.slotForPath(path);
+  // Slot pages are fixed when the book is placed; follow the log if the estimate moved.
+  if (slot >= 0 && s.slots[slot].pages != pages) {
+    s.slots[slot].pages = static_cast<uint16_t>(pages);
+    stateDirty = true;
+  }
+}
+
+bool Store::notePage(const int startBp, const int endBp, const bool atLastPage) {
+  if (!tracking || hatch.hatched) return false;
+  const int added = log.markSpan(startBp, endBp);
+  if (added > 0) {
+    logDirty = true;
+    unsavedPages += added;
+  }
+  State& s = state();
+  const int32_t now = today();
+  const int slot = s.slotForPath(bookPath);
+  if (slot >= 0) {
+    // Egg progress is the reading position, so a jump forward or back moves the egg with it.
+    const int position = atLastPage ? bookPages : static_cast<int>(static_cast<int64_t>(std::clamp(endBp, 0, 10000)) * bookPages / 10000);
+    const bool moved = s.slots[slot].readPages != std::min(position, static_cast<int>(s.slots[slot].pages));
+    hatch = noteSlotPages(s, slot, added, position, atLastPage, now);
+    if (moved) stateDirty = true;
+    if (added > 0) stateDirty = true;
+    if (hatch.hatched) {
+      save();
+      Storage.remove(logPath(bookPath).c_str());
+      logDirty = false;
+      tracking = isCompanionBook(s, bookPages);
+      if (tracking) log.reset(bookPages);
+      return true;
+    }
+  }
+  // The companion (the character on the sleep screen) eats / keeps its torch in both phases.
+  if (s.companion.charId != NO_CHAR && added > 0) {
+    noteCompanionPages(s, bookPages, added, now);
+    stateDirty = true;
+  }
+  if (unsavedPages >= SAVE_EVERY_PAGES) flushBook();
+  return false;
+}
+
+void Store::flushLog() {
+  if (!tracking || !logDirty) return;
+  Storage.mkdir(PAGES_DIR);
+  const std::vector<uint8_t> bytes = log.serialize();
+  const std::string path = logPath(bookPath);
+  const auto slash = path.rfind('/');
+  if (!ProgressFile::writeAtomic(path.substr(0, slash), path.substr(slash + 1).c_str(), bytes.data(), bytes.size())) {
+    LOG_ERR("OLY", "could not save page log");
+  }
+  logDirty = false;
+  unsavedPages = 0;
+}
+
+void Store::flushBook() {
+  flushLog();
+  if (stateDirty) save();
+}
+
+void Store::markSeen(const uint8_t id) {
+  if (!state().isFresh(id)) return;
+  setBit(data.fresh, id, false);
+  save();
+}
+
+void Store::setSleepChar(const uint8_t id) {
+  state().sleepChar = id;
+  save();
+}
+
+void Store::chooseCompanion(const uint8_t id) {
+  olympus::chooseCompanion(state(), id, today());
+  save();
+}
+
+void Store::refreshDay() {
+  State& s = state();
+  const Companion before = s.companion;
+  // Saves from before companions existed in phase 1: the chosen sleep character becomes the companion.
+  if (s.companion.charId == NO_CHAR && s.companion.leftCharId == NO_CHAR && s.sleepChar != NO_CHAR &&
+      s.isHatched(s.sleepChar)) {
+    olympus::chooseCompanion(s, s.sleepChar, today());
+    save();
+    return;
+  }
+  rollover(s, today());
+  if (before.day != s.companion.day || before.charId != s.companion.charId) save();
+}
+
+}  // namespace olympus
