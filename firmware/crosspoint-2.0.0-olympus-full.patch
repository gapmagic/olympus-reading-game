+void OlympusActivity::renderTierComplete() {
+  const auto& s = olympus::store().state();
+  const Tier tier = hatch.tier;
+  // Ring of dots, one per character.
+  constexpr int cx = W / 2, cy = 200, radius = 130;
+  for (int i = 0; i < PER_TIER; ++i) {
+    const float a = i * 2 * 3.14159f / PER_TIER;
+    const int x = cx + static_cast<int>(radius * std::cos(a));
+    const int y = cy + static_cast<int>(radius * 0.85f * std::sin(a));
+    renderer.fillRoundedRect(x - 6, y - 4, 12, 8, 4, Color::Black);
+  }
+  draw::centered(renderer, NOTOSANS_18_FONT_ID, cx, cy - 46, "30/30", true, true);
+  draw::centered(renderer, UI_10_FONT_ID, cx, cy, draw::tierUpperName(tier), true, true);
+  const char* kind = tier == Tier::Clay ? OLY_T("Sinh vật và tiểu thần", "Creatures and minor gods") : (tier == Tier::Silver ? OLY_T("Thần Olympus", "Olympian gods") : "Titan");
+  draw::centered(renderer, SMALL_FONT_ID, cx, cy + 30, kind);
+
+  char buf[200];
+  snprintf(buf, sizeof(buf), OLY_T("Đã sưu tầm đủ bộ %s!", "%s set complete!"), draw::tierEggName(tier));
+  draw::centered(renderer, UI_12_FONT_ID, W / 2, 380, buf, true, true);
+  int shown = 0;
+  for (int i = 0; i < PER_TIER && shown < 6; ++i) {
+    const auto id = static_cast<uint8_t>(static_cast<int>(tier) * PER_TIER + i);
+    draw::character(renderer, id, 24 + shown * 74, 430, 64);
+    ++shown;
+  }
+  snprintf(buf, sizeof(buf), OLY_T("Tất cả 30 nhân vật bậc này đã về Đền thờ. Từ giờ sách %s đặt vào lò ấp sẽ không nở thêm "
+                             "nhân vật.", "All 30 characters of this tier are in the Temple. From now on, books of %s placed in the incubator will hatch " "nothing."),
+           draw::tierBookRange(tier));
+  const int y = draw::wrap(renderer, UI_10_FONT_ID, 30, 520, W - 60, buf, 4);
+  if (s.phase2()) {
+    draw::wrap(renderer, UI_10_FONT_ID, 30, y + 16, W - 60,
+               OLY_T("Đủ 90/90! Lò ấp đóng lại. Vào Đền thờ để chọn một bạn đồng hành và giữ thói quen đọc mỗi ngày.", "90/90! The Incubator closes. Visit the Temple to choose a companion and keep your daily reading habit."), 4,
+               true, true);
+  } else {
+    std::string missing = OLY_T("Bộ còn thiếu:", "Still missing:");
+    bool firstTier = true;
+    for (int t = 0; t < olympus::TIER_COUNT; ++t) {
+      const int left = PER_TIER - s.hatchedCount(static_cast<Tier>(t));
+      if (left == 0) continue;
+      missing += firstTier ? " " : OLY_T(" · ", " · ");
+      missing += std::string(draw::tierShortName(static_cast<Tier>(t))) + " " + std::to_string(left);
+      firstTier = false;
+    }
+    renderer.drawText(UI_10_FONT_ID, 30, y + 16, missing.c_str(), true, EpdFontFamily::BOLD);
+  }
+  drawHints(overReader ? OLY_T("Đọc tiếp", "Keep reading") : OLY_T("Quay lại", "Back"), OLY_T("Đền thờ", "Temple"), "", "");
+}
+
+void OlympusActivity::renderModal() {
+  constexpr int x = 40, w = W - 80;
+  const int lh = renderer.getLineHeight(UI_10_FONT_ID);
+  const auto lines = renderer.wrappedText(UI_10_FONT_ID, modal.body.c_str(), w - 40, 8);
+  const int h = 70 + static_cast<int>(lines.size()) * lh + 70;
+  const int y = (800 - h) / 2;
+  renderer.fillRect(x - 4, y - 4, w + 8, h + 8, false);
+  renderer.drawRoundedRect(x, y, w, h, 3, 12, true);
+  draw::centered(renderer, UI_12_FONT_ID, W / 2, y + 18, modal.title.c_str(), true, true);
+  int ty = y + 60;
+  for (const auto& line : lines) {
+    renderer.drawText(UI_10_FONT_ID, x + 20, ty, line.c_str());
+    ty += lh;
+  }
+  const int count = static_cast<int>(modal.options.size());
+  const int bw = (w - 40 - (count - 1) * 16) / count;
+  modalRects.assign(static_cast<size_t>(count), Rect{});
+  for (int i = 0; i < count; ++i) {
+    const int bx = x + 20 + i * (bw + 16);
+    const int by = y + h - 56;
+    modalRects[static_cast<size_t>(i)] = Rect{bx, by - 8, bw, 56};
+    if (i == modal.selected) {
+      renderer.fillRoundedRect(bx, by, bw, 40, 8, Color::Black);
+    } else {
+      renderer.drawRoundedRect(bx, by, bw, 40, 2, 8, true);
+    }
+    draw::centered(renderer, UI_10_FONT_ID, bx + bw / 2, by + 8, modal.options[i].c_str(), i != modal.selected, true);
+  }
+}
