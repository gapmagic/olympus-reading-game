+std::string bookTitle(const std::string& path) {
+  for (const auto& book : RECENT_BOOKS.getBooks()) {
+    if (book.path == path && !book.title.empty()) return book.title;
+  }
+  const auto slash = path.rfind('/');
+  std::string name = slash == std::string::npos ? path : path.substr(slash + 1);
+  const auto dot = name.rfind('.');
+  if (dot != std::string::npos && dot > 0) name.resize(dot);
+  return name;
+}
+
+void useOlympusSleepScreen() {
+  if (SETTINGS.sleepScreen == CrossPointSettings::SLEEP_SCREEN_MODE::OLYMPUS) return;
+  SETTINGS.sleepScreen = CrossPointSettings::SLEEP_SCREEN_MODE::OLYMPUS;
+  SETTINGS.saveToFile();
+}
+
+void dashedRect(const GfxRenderer& r, const int x, const int y, const int w, const int h) {
+  for (int i = 0; i < w; i += 12) {
+    r.fillRect(x + i, y, std::min(6, w - i), 2, true);
+    r.fillRect(x + i, y + h - 2, std::min(6, w - i), 2, true);
+  }
+  for (int i = 0; i < h; i += 12) {
+    r.fillRect(x, y + i, 2, std::min(6, h - i), true);
+    r.fillRect(x + w - 2, y + i, 2, std::min(6, h - i), true);
+  }
+}
