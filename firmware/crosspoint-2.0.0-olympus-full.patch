@@ -0,0 +1,37 @@
+#include "OlympusFonts.h"
+
+#include <EpdFontFamily.h>
+#include <GfxRenderer.h>
+#include <builtinFonts/alegreya_11_bold.h>
+#include <builtinFonts/alegreya_11_regular.h>
+#include <builtinFonts/alegreya_13_bold.h>
+#include <builtinFonts/alegreya_9_bold.h>
+#include <builtinFonts/alegreya_9_regular.h>
+#include <builtinFonts/cormorantsc_12_bold.h>
+#include <builtinFonts/cormorantsc_14_bold.h>
+#include <builtinFonts/cormorantsc_16_bold.h>
+#include <builtinFonts/cormorantsc_20_bold.h>
+
+namespace olympus::fonts {
+namespace {
+const EpdFont small(&alegreya_9_regular);
+const EpdFont smallBold(&alegreya_9_bold);
+const EpdFont body(&alegreya_11_regular);
+const EpdFont bodyBold(&alegreya_11_bold);
+const EpdFont button(&alegreya_13_bold);
+const EpdFont labelSmall(&cormorantsc_12_bold);
+const EpdFont label(&cormorantsc_14_bold);
+const EpdFont name(&cormorantsc_16_bold);
+const EpdFont title(&cormorantsc_20_bold);
+}  // namespace
+
+void registerAll(GfxRenderer& r) {
+  r.insertFont(SMALL, EpdFontFamily(9, &small, &smallBold));
+  r.insertFont(BODY, EpdFontFamily(11, &body, &bodyBold));
+  r.insertFont(BUTTON, EpdFontFamily(13, &button, &button));
+  r.insertFont(LABEL_SMALL, EpdFontFamily(12, &labelSmall, &labelSmall));
+  r.insertFont(LABEL, EpdFontFamily(14, &label, &label));
+  r.insertFont(NAME, EpdFontFamily(16, &name, &name));
+  r.insertFont(TITLE, EpdFontFamily(20, &title, &title));
+}
+}  // namespace olympus::fonts
