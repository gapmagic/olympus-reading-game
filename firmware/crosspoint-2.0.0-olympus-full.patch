+
+void OlympusActivity::routeTouch() {
+  int x = 0;
+  int y = 0;
+  if (mappedInput.wasScreenLongPress(x, y)) {
+    if (!modal.active && hitContent(x, y, true)) virtualHold = true;
+    return;
+  }
+  if (!mappedInput.wasScreenTapped(x, y)) {
+    // Swipes step through profiles and temple pages.
+    const auto swipe = mappedInput.wasSwipe();
+    if (modal.active || swipe == MappedInputManager::SwipeDir::None) return;
+    const Screen s = current();
+    if (s == Screen::Temple) {
+      // Up/down flips the 16-card page; tiers are switched by tapping the tabs.
+      const int first = templeIndex / GRID_PER_PAGE * GRID_PER_PAGE;
+      if (swipe == MappedInputManager::SwipeDir::Up && first + GRID_PER_PAGE < PER_TIER) templeIndex = first + GRID_PER_PAGE;
+      if (swipe == MappedInputManager::SwipeDir::Down && first > 0) templeIndex = first - GRID_PER_PAGE;
+      requestUpdate();
+      return;
+    }
+    if (s != Screen::Profile) return;
+    if (swipe == MappedInputManager::SwipeDir::Left) virtualButton = static_cast<int>(Button::Right);
+    if (swipe == MappedInputManager::SwipeDir::Right) virtualButton = static_cast<int>(Button::Left);
+    if (swipe == MappedInputManager::SwipeDir::Up) virtualButton = static_cast<int>(Button::Down);
+    if (swipe == MappedInputManager::SwipeDir::Down) virtualButton = static_cast<int>(Button::Up);
+    return;
+  }
+  if (modal.active) {
+    for (size_t i = 0; i < modalRects.size(); ++i) {
+      if (modalRects[i].contains(x, y)) {
+        modal.selected = static_cast<int>(i);
+        virtualButton = static_cast<int>(Button::Confirm);
+        return;
+      }
+    }
+    return;
+  }
+  constexpr Button BAR[4] = {Button::Back, Button::Confirm, Button::Left, Button::Right};
+  for (int i = 0; i < 4; ++i) {
+    if (barRects[i].contains(x, y)) {
+      virtualButton = static_cast<int>(BAR[i]);
+      return;
+    }
+  }
+  if (hitContent(x, y, false)) virtualButton = static_cast<int>(Button::Confirm);
+}
+
+// Maps a tap (or long-press) on screen content to a selection. Returns true when it should act like OK.
+bool OlympusActivity::hitContent(const int x, const int y, const bool hold) {
+  switch (current()) {
+    case Screen::Hub:
+      if (y >= 130 && y < 330) {
+        hubSelected = 0;
+        return !hold;
+      }
+      if (y >= 350 && y < 550) {
+        hubSelected = 1;
+        return !hold;
+      }
+      return false;
+    case Screen::Incubator:
+      for (int i = 0; i < olympus::SLOT_COUNT; ++i) {
+        const int top = 96 + i * 220;
+        if (y >= top && y < top + 206) {
+          incubatorSelected = i;
+          requestUpdate();
+          return true;
+        }
+      }
+      return false;
+    case Screen::Temple: {
+      if (!hold && y >= 60 && y < 106 && x >= 24) {
+        const int tab = (x - 24) / 148;
+        if (tab < olympus::TIER_COUNT) {
+          templeTab = tab;
+          templeIndex = 0;
+          requestUpdate();
+        }
+        return false;
+      }
+      const int first = templeIndex / GRID_PER_PAGE * GRID_PER_PAGE;
+      if (x < 24 || y < 132) return false;
+      const int col = (x - 24) / 110;
+      const int row = (y - 132) / 146;
+      if (col >= GRID_COLS || row >= GRID_PER_PAGE / GRID_COLS) return false;
+      const int index = first + row * GRID_COLS + col;
+      if (index >= PER_TIER) return false;
+      templeIndex = index;
+      requestUpdate();
+      return true;
+    }
+    case Screen::Profile:
+      return false;
+    case Screen::Hatch:
+    case Screen::TierComplete:
+    case Screen::Companion:
+      return !hold;
+  }
+  return false;
+}
+
+void OlympusActivity::loop() {
+  virtualButton = -1;
+  virtualHold = false;
+  if (mappedInput.hasTouch()) routeTouch();
+  if (modal.active) {
+    loopModal();
+    return;
+  }
+  if (released(Button::Back)) {
+    back();
+    return;
+  }
+  switch (current()) {
+    case Screen::Hub:
+      loopHub();
+      break;
+    case Screen::Incubator:
+      loopIncubator();
+      break;
+    case Screen::Temple:
+      loopTemple();
+      break;
+    case Screen::Profile:
+      loopProfile();
+      break;
+    case Screen::Hatch:
+      if (released(Button::Confirm)) {
+        if (hatch.empty) {
+          back();
+        } else {
+          openProfile(hatch.charId);
+        }
+      } else if (released(Button::Left)) {
+        back();
+      }
+      break;
+    case Screen::TierComplete:
+      if (released(Button::Confirm)) push(Screen::Temple);
+      break;
+    case Screen::Companion:
+      if (released(Button::Confirm)) push(Screen::Temple);
+      break;
+  }
+}
+
+void OlympusActivity::loopModal() {
+  const int count = static_cast<int>(modal.options.size());
+  if (released(Button::Back)) {
+    modal.active = false;
+    requestUpdate();
+    return;
+  }
+  if (pressed(Button::Left) || pressed(Button::Up)) {
+    modal.selected = (modal.selected + count - 1) % count;
+    requestUpdate();
+  } else if (pressed(Button::Right) || pressed(Button::Down)) {
+    modal.selected = (modal.selected + 1) % count;
+    requestUpdate();
+  } else if (released(Button::Confirm)) {
+    modal.active = false;
+    auto pick = std::move(modal.onPick);
+    const int choice = modal.selected;
+    requestUpdate();
+    if (pick) pick(choice);
+  }
+}
+
+void OlympusActivity::loopHub() {
+  if (pressed(Button::Up) || pressed(Button::Down) ||
+      pressed(Button::Left) || pressed(Button::Right)) {
+    hubSelected = 1 - hubSelected;
+    requestUpdate();
+    return;
+  }
+  if (!released(Button::Confirm)) return;
+  if (hubSelected == 1) {
+    push(Screen::Temple);
+  } else if (olympus::store().state().phase2()) {
+    push(Screen::Companion);
+  } else {
+    push(Screen::Incubator);
+  }
+}
+
+void OlympusActivity::loopIncubator() {
+  auto& st = olympus::store();
+  if (pressed(Button::Up) || pressed(Button::Left)) {
+    incubatorSelected = (incubatorSelected + olympus::SLOT_COUNT - 1) % olympus::SLOT_COUNT;
+    requestUpdate();
+    return;
+  }
+  if (pressed(Button::Down) || pressed(Button::Right)) {
+    incubatorSelected = (incubatorSelected + 1) % olympus::SLOT_COUNT;
+    requestUpdate();
+    return;
+  }
+  const olympus::Slot& slot = st.state().slots[incubatorSelected];
+  if (heldLong(Button::Confirm)) {
+    // A press that ran long on an empty slot still means "add a book".
+    if (!slot.used) {
+      activityManager.goToLibrary();
+      return;
+    }
+    const std::string title = bookTitle(slot.path);
+    const int index = incubatorSelected;
+    showModal(OLY_T("Bỏ trứng?", "Discard egg?"),
+              OLY_T("Trứng của \"", "The egg of \"") + title +
+                  OLY_T("\" sẽ mất. Nhân vật trong trứng được giữ chỗ và sẽ nở từ quả trứng tiếp theo cùng bậc."
+                  "", "\" will be lost. Its character is reserved and will hatch from the next egg of the same tier." ""),
+              {OLY_T("Huỷ", "Cancel"), OLY_T("Bỏ trứng", "Discard egg")}, 0, [this, index](const int choice) {
+                if (choice == 1) olympus::store().discardSlot(index);
+                requestUpdate();
+              });
+    return;
+  }
+  if (released(Button::Confirm)) {
+    // A filled slot opens its book; an empty one goes to the library to pick a book to incubate.
+    if (slot.used) {
+      activityManager.goToReader(slot.path);
+    } else {
+      activityManager.goToLibrary();
+    }
+  }
+}
+
+void OlympusActivity::loopTemple() {
+  auto& st = olympus::store();
+  const bool hold = mappedInput.wasLongPressed(Button::Left, HOLD_MS) || mappedInput.wasLongPressed(Button::Right, HOLD_MS);
+  if (hold) {
+    templeTab = (templeTab + (mappedInput.isPressed(Button::Left) ? 2 : 1)) % olympus::TIER_COUNT;
+    templeIndex = 0;
+    requestUpdate();
+    return;
+  }
+  int index = templeIndex;
+  if (released(Button::Left)) index -= 1;
+  if (released(Button::Right)) index += 1;
+  if (pressed(Button::Up)) index -= GRID_COLS;
+  if (pressed(Button::Down)) index += GRID_COLS;
+  if (index != templeIndex) {
+    if (index < 0) {
+      templeTab = (templeTab + olympus::TIER_COUNT - 1) % olympus::TIER_COUNT;
+      index = PER_TIER - 1;
+    } else if (index >= PER_TIER) {
+      templeTab = (templeTab + 1) % olympus::TIER_COUNT;
+      index = 0;
+    }
+    templeIndex = index;
+    requestUpdate();
+    return;
+  }
+  const auto id = static_cast<uint8_t>(templeTab * PER_TIER + templeIndex);
+  if (heldLong(Button::Confirm)) {
+    profileId = id;
+    loopProfile();  // reuse the choose-companion confirmation
+    return;
+  }
+  if (released(Button::Confirm)) openProfile(id);
+}
+
+void OlympusActivity::loopProfile() {
+  auto& st = olympus::store();
+  const auto& s = st.state();
+  const int tierBase = static_cast<int>(olympus::tierOf(profileId)) * PER_TIER;
+  if (current() == Screen::Profile) {
+    int step = 0;
+    if (pressed(Button::Left) || pressed(Button::Up)) step = -1;
+    if (pressed(Button::Right) || pressed(Button::Down)) step = 1;
+    if (step != 0) {
+      const auto next = static_cast<uint8_t>(tierBase + (olympus::indexInTier(profileId) + PER_TIER + step) % PER_TIER);
+      profileId = next;
+      templeIndex = olympus::indexInTier(next);
+      st.markSeen(next);
+      requestUpdate();
+      return;
+    }
+    if (!released(Button::Confirm)) return;
+  }
+  if (!s.isHatched(profileId) || s.companion.charId == profileId) return;
+  const olympus::Character& ch = olympus::character(profileId);
+  const uint8_t id = profileId;
+  const Tier tier = olympus::tierOf(id);
+  char body[360];
+  snprintf(body, sizeof(body),
+           OLY_T("Nhân vật sẽ thành bạn đồng hành. Chỉ tính %s (%s), mục tiêu %d trang mỗi ngày. Bạn đồng hành cũ về lại đền, chuỗi ngày bắt đầu từ 0.", "This character becomes your companion. Only %s count (%s), goal %d pages a day. Your old companion returns to the Temple and the streak restarts from 0."),
+           draw::tierBookName(tier), draw::tierBookRange(tier), olympus::dailyGoal(tier));
+  showModal(std::string(OLY_T("Đặt ", "Set ")) + ch.name + OLY_T(" làm màn chờ?", " as sleep screen?"), body, {OLY_T("Huỷ", "Cancel"), OLY_T("Đặt", "Set")}, 1, [this, id](const int choice) {
+    if (choice != 1) return;
+    olympus::store().chooseCompanion(id);
+    useOlympusSleepScreen();
+    if (olympus::store().state().phase2()) {
+      stack.assign({Screen::Hub, Screen::Companion});
+      if (overReader) stack.assign(1, Screen::Companion);
+    }
+    requestUpdate();
+  });
+}
