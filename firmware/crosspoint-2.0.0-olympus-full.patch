+    return;
+  }
+  if (state.slotForPath(path) >= 0) {
+    showLibraryMessage(OLY_T("Đang ấp", "Incubating"), OLY_T("Cuốn này đã ở trong lò ấp.", "This book is already in the incubator."));
+    return;
+  }
+  if (state.usedSlots() >= olympus::SLOT_COUNT) {
+    showLibraryMessage(OLY_T("Lò ấp đã đầy", "Incubator is full"),
+                       OLY_T("Cả 3 ô đang ấp. Đọc xong một cuốn, hoặc giữ OK (nhấn giữ) trên một ô trong Lò ấp để bỏ trứng.", "All 3 slots are incubating. Finish a book, or hold OK (long-press) on a slot in the Incubator to discard its egg."));
+    return;
+  }
+  int pages = 0;
+  {
+    RenderLock lock(*this);
+    GUI.drawPopup(renderer, tr(STR_LOADING_POPUP));
+    pages = olympus::Store::pagesForBook(path);
+  }
+  if (pages <= 0) {
+    showLibraryMessage(OLY_T("Không đặt được", "Cannot add"), OLY_T("Không đọc được số trang của cuốn này.", "Could not read the page count of this book."));
+    return;
+  }
+  const olympus::Tier tier = olympus::tierForPages(pages);
+  const char* const eggNames[] = {OLY_T("Trứng đất sét", "Clay egg"), OLY_T("Trứng bạc", "Silver egg"), OLY_T("Trứng vàng", "Gold egg")};
+  const char* eggName = eggNames[static_cast<int>(tier)];
+  std::string message = title + OLY_T(" · ", " · ") + std::to_string(pages) + OLY_T(" trang. Sách ", " pages. A book of ") + std::to_string(pages) +
+                        OLY_T(" trang nên sẽ nhận một ", " pages, so it gets a ") + eggName + OLY_T(". Lò ấp còn trống ", ". Free incubator slots: ") +
+                        std::to_string(olympus::SLOT_COUNT - state.usedSlots()) + OLY_T("/3 ô.", "/3.");
+  if (state.hatchedCount(tier) >= olympus::PER_TIER) {
+    message += std::string(OLY_T(" Bạn đã đủ bộ ", " You already have the full ")) + eggName + OLY_T(" nên quả trứng này sẽ không nở ra gì.", " set, so this egg will not hatch anything.");
+  }
+  const int readPercent = std::clamp(loadSavedBookPercent(path), 0, 100);
+  if (readPercent > 0) {
+    message += OLY_T(" Phần đã đọc (", " Pages already read (") + std::to_string(readPercent) + OLY_T("%) được tính luôn cho trứng.", "%) count toward the egg.");
+  }
+  message += OLY_T(" Bỏ trứng giữa chừng sẽ mất trứng,"
+             " nhưng nhân vật trong trứng vẫn chờ bạn ở quả sau.", " Discarding an egg midway loses the egg," " but its character waits for you in the next egg.");
+  const char* OPTIONS[] = {tr(STR_CANCEL), OLY_T("Đặt vào", "Add")};
+  optionPopup.showMessage(OLY_T("Đặt vào lò ấp?", "Put in incubator?"), message.c_str(), OPTIONS, 2, 1, [this, path, pages, readPercent](const int choice) {
+    if (choice == 1) {
+      olympus::store().placeBook(path, pages, readPercent * 100);
+      // Rules §5: once the game starts, the sleep screen belongs to Olympus (incubator only until a hatch).
+      if (SETTINGS.sleepScreen != CrossPointSettings::SLEEP_SCREEN_MODE::OLYMPUS) {
+        SETTINGS.sleepScreen = CrossPointSettings::SLEEP_SCREEN_MODE::OLYMPUS;
+        SETTINGS.saveToFile();
+      }
+      for (auto& slot : percentSlots) slot = PercentSlot{};
+    }
+    requestUpdate();
+  });
+  requestUpdate();
+}
