new file mode 100644
index 00000000..de7f70e0
--- /dev/null
+++ b/src/olympus/OlympusSprite.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+
+namespace olympus {
+
+// 2 bits per pixel, 4 pixels per byte (MSB first): 0 black, 1 dark gray, 2 light gray, 3 white.
+struct Sprite {
+  uint16_t width;
+  uint16_t height;
+  const uint8_t* pixels;
+
+  uint8_t tone(const int x, const int y) const {
+    const int i = y * width + x;
+    return (pixels[i >> 2] >> (6 - 2 * (i & 3))) & 3;
+  }
+};
+
+}  // namespace olympus
