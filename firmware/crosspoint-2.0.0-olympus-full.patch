--- /dev/null
+++ b/src/olympus/OlympusRules.cpp
@@ -0,0 +1,458 @@
+#include "OlympusRules.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace olympus {
+
+Tier tierForPages(const int pages) {
+  if (pages <= 200) return Tier::Clay;
+  if (pages <= 499) return Tier::Silver;
+  return Tier::Gold;
+}
+
+int dailyGoal(const Tier tier) {
+  switch (tier) {
+    case Tier::Clay:
+      return 5;
+    case Tier::Silver:
+      return 10;
+    case Tier::Gold:
+      return 20;
+  }
+  return 5;
+}
+
+int crackStage(const int readPages, const int pages) {
+  if (pages <= 0) return 0;
+  const long pct = static_cast<long>(readPages) * 100 / pages;
+  if (pct >= 75) return 3;
+  if (pct >= 50) return 2;
+  if (pct >= 25) return 1;
+  return 0;
+}
+
+int pagesForEpubBytes(const size_t bytes) {
+  const size_t pages = (bytes + EPUB_BYTES_PER_PAGE - 1) / EPUB_BYTES_PER_PAGE;
+  return static_cast<int>(std::clamp<size_t>(pages, 1, 60000));
+}
+
+// ---- PageLog ----
+
+void PageLog::reset(const int pages) {
+  pageCount = std::clamp(pages, 0, 60000);
+  read = 0;
+  bits.assign(static_cast<size_t>((pageCount + 7) / 8), 0);
+}
+
+bool PageLog::isRead(const int page) const {
+  if (page < 0 || page >= pageCount) return false;
+  return (bits[static_cast<size_t>(page >> 3)] >> (page & 7)) & 1;
+}
+
+int PageLog::mark(const int page) {
+  if (page < 0 || page >= pageCount || isRead(page)) return 0;
+  bits[static_cast<size_t>(page >> 3)] |= static_cast<uint8_t>(1 << (page & 7));
+  ++read;
+  return 1;
+}
+
+int PageLog::markSpan(int startBp, int endBp) {
+  if (pageCount <= 0) return 0;
+  startBp = std::clamp(startBp, 0, 10000);
+  endBp = std::clamp(endBp, startBp, 10000);
+  const long n = pageCount;
+  int added = mark(static_cast<int>(std::min<long>(n - 1, startBp * n / 10000)));
+  // Page i's midpoint is (2i + 1) * 10000 / (2n); walk the pages whose midpoint lies in the span.
+  long first = (2L * startBp * n / 10000 - 1) / 2;
+  if (first < 0) first = 0;
+  for (long i = first; i < n; ++i) {
+    const long mid2n = (2 * i + 1) * 10000;  // midpoint scaled by 2n
+    if (mid2n < 2L * n * startBp) continue;
+    if (mid2n >= 2L * n * endBp) break;
+    added += mark(static_cast<int>(i));
+  }
+  return added;
+}
+
+std::vector<uint8_t> PageLog::serialize() const {
+  std::vector<uint8_t> out;
+  out.reserve(6 + bits.size());
+  out.insert(out.end(), {'O', 'P', 'L', '1'});
+  out.push_back(static_cast<uint8_t>(pageCount & 0xFF));
+  out.push_back(static_cast<uint8_t>(pageCount >> 8));
+  out.insert(out.end(), bits.begin(), bits.end());
+  return out;
+}
+
+bool PageLog::deserialize(const uint8_t* data, const size_t len) {
+  if (len < 6 || memcmp(data, "OPL1", 4) != 0) return false;
+  const int pages = data[4] | (data[5] << 8);
+  if (len != 6 + static_cast<size_t>((pages + 7) / 8)) return false;
+  reset(pages);
+  std::copy(data + 6, data + len, bits.begin());
+  read = 0;
+  for (int i = 0; i < pageCount; ++i) read += isRead(i) ? 1 : 0;
+  return true;
+}
+
+// ---- State ----
+
+void setBit(uint8_t* bits, const uint8_t id, const bool on) {
+  if (id >= TOTAL_CHARACTERS) return;
+  if (on) {
+    bits[id >> 3] |= static_cast<uint8_t>(1 << (id & 7));
+  } else {
+    bits[id >> 3] &= static_cast<uint8_t>(~(1 << (id & 7)));
+  }
+}
+
+bool getBit(const uint8_t* bits, const uint8_t id) {
+  return id < TOTAL_CHARACTERS && ((bits[id >> 3] >> (id & 7)) & 1);
+}
+
+bool State::isHatched(const uint8_t id) const { return getBit(hatched, id); }
+bool State::isFresh(const uint8_t id) const { return getBit(fresh, id); }
+bool State::isReserved(const uint8_t id) const { return getBit(reserved, id); }
+
+int State::hatchedCount(const Tier tier) const {
+  int n = 0;
+  const int base = static_cast<int>(tier) * PER_TIER;
+  for (int i = 0; i < PER_TIER; ++i) n += isHatched(static_cast<uint8_t>(base + i)) ? 1 : 0;
+  return n;
+}
+
+int State::totalHatched() const {
+  int n = 0;
+  for (int i = 0; i < TOTAL_CHARACTERS; ++i) n += isHatched(static_cast<uint8_t>(i)) ? 1 : 0;
+  return n;
+}
+
+bool State::anyFresh() const {
+  for (const uint8_t b : fresh) {
+    if (b) return true;
+  }
+  return false;
+}
+
+int State::usedSlots() const {
+  int n = 0;
+  for (const auto& s : slots) n += s.used ? 1 : 0;
+  return n;
+}
+
+int State::slotForPath(const std::string& path) const {
+  for (int i = 0; i < SLOT_COUNT; ++i) {
+    if (slots[i].used && slots[i].path == path) return i;
+  }
+  return -1;
+}
+
+uint8_t State::screenChar() const { return companion.charId != NO_CHAR ? companion.charId : sleepChar; }
+
+namespace {
+uint32_t nextRandom(State& state) {
+  uint32_t x = state.rng ? state.rng : 0x9E3779B9u;
+  x ^= x << 13;
+  x ^= x >> 17;
+  x ^= x << 5;
+  state.rng = x;
+  return x;
+}
+
+bool inAnySlot(const State& state, const uint8_t id) {
+  for (const auto& s : state.slots) {
+    if (s.used && s.charId == id) return true;
+  }
+  return false;
+}
+}  // namespace
+
+uint8_t pickCharacter(State& state, const Tier tier) {
+  const int base = static_cast<int>(tier) * PER_TIER;
+  uint8_t candidates[PER_TIER];
+  int count = 0;
+  for (int pass = 0; pass < 2 && count == 0; ++pass) {
+    for (int i = 0; i < PER_TIER; ++i) {
+      const auto id = static_cast<uint8_t>(base + i);
+      if (state.isHatched(id) || inAnySlot(state, id)) continue;
+      if ((pass == 0) != state.isReserved(id)) continue;
+      candidates[count++] = id;
+    }
+  }
+  if (count == 0) return NO_CHAR;
+  return candidates[nextRandom(state) % static_cast<uint32_t>(count)];
+}
+
+PlaceResult placeBook(State& state, const std::string& path, const int pages, const int32_t today, int* slotOut) {
+  if (state.phase2()) return PlaceResult::Closed;
+  if (path.empty() || pages <= 0) return PlaceResult::BadBook;
+  if (state.slotForPath(path) >= 0) return PlaceResult::AlreadyIncubating;
+  int free = -1;
+  for (int i = 0; i < SLOT_COUNT && free < 0; ++i) {
+    if (!state.slots[i].used) free = i;
+  }
+  if (free < 0) return PlaceResult::Full;
+  Slot& slot = state.slots[free];
+  slot = Slot{};
+  slot.tier = tierForPages(pages);
+  slot.charId = pickCharacter(state, slot.tier);
+  slot.pages = static_cast<uint16_t>(std::min(pages, 60000));
+  slot.lastReadDay = today;
+  slot.path = path;
+  slot.used = true;
+  if (slot.charId != NO_CHAR) setBit(state.reserved, slot.charId, false);
+  if (slotOut) *slotOut = free;
+  return slot.charId == NO_CHAR ? PlaceResult::PlacedEmpty : PlaceResult::Placed;
+}
+
+// No limit: an egg can be discarded at any time (the month is still recorded for reference).
+bool canDiscard(const State&, const int32_t) { return true; }
+
+bool discardSlot(State& state, const int slot, const int32_t month) {
+  if (slot < 0 || slot >= SLOT_COUNT || !state.slots[slot].used || !canDiscard(state, month)) return false;
+  if (state.slots[slot].charId != NO_CHAR) setBit(state.reserved, state.slots[slot].charId, true);
+  state.slots[slot] = Slot{};
+  state.lastDiscardMonth = month;
+  return true;
+}
+
+HatchEvent noteSlotPages(State& state, const int slotIndex, const int newPages, const int readPages,
+                         const bool atLastPage, const int32_t today) {
+  HatchEvent event;
+  if (slotIndex < 0 || slotIndex >= SLOT_COUNT || !state.slots[slotIndex].used) return event;
+  Slot& slot = state.slots[slotIndex];
+  slot.readPages = static_cast<uint16_t>(std::clamp(readPages, 0, static_cast<int>(slot.pages)));
+  if (newPages > 0 && today >= 0) slot.lastReadDay = today;
+  // The egg follows the reading position and hatches on the book's last page.
+  if (!atLastPage) return event;
+
+  event.hatched = true;
+  event.charId = slot.charId;
+  event.tier = slot.tier;
+  event.empty = slot.charId == NO_CHAR;
+  event.bookPath = slot.path;
+  event.bookPages = slot.pages;
+  if (!event.empty) {
+    setBit(state.hatched, slot.charId, true);
+    setBit(state.fresh, slot.charId, true);
+    setBit(state.reserved, slot.charId, false);
+    event.tierCompleted = state.hatchedCount(slot.tier) == PER_TIER;
+  }
+  slot = Slot{};
+  if (state.phase2()) {
+    event.allCompleted = !event.empty;
+    // The incubator closes for good; any egg left can only be empty.
+    for (auto& s : state.slots) s = Slot{};
+  }
+  return event;
+}
+
+// ---- Companion ----
+
+bool isCompanionBook(const State& state, const int bookPages) {
+  return state.companion.charId != NO_CHAR && bookPages > 0 &&
+         tierForPages(bookPages) == tierOf(state.companion.charId);
+}
+
+void rollover(State& state, const int32_t today) {
+  Companion& c = state.companion;
+  if (today < 0) return;
+  if (c.charId == NO_CHAR || c.day < 0) {
+    c.day = today;
+    return;
+  }
+  if (today <= c.day) return;  // same day, or the clock went back
+  const long missedNow = (c.goalMetToday ? 0 : 1) + (static_cast<long>(today) - c.day - 1);
+  c.day = today;
+  c.todayPages = 0;
+  c.goalMetToday = false;
+  if (missedNow <= 0) return;
+  const long total = c.missed + missedNow;
+  c.missed = static_cast<uint8_t>(std::min<long>(total, MAX_MISSED_DAYS));
+  if (total < MAX_MISSED_DAYS) return;
+  c.streak = 0;
+  if (tierOf(c.charId) == Tier::Clay) {
+    c.leftCharId = c.charId;
+    c.charId = NO_CHAR;
+    c.missed = 0;
+  } else {
+    c.ember = true;
+  }
+}
+
+bool noteCompanionPages(State& state, const int bookPages, const int newPages, const int32_t today) {
+  if (today < 0 || newPages <= 0) return false;
+  rollover(state, today);
+  if (!isCompanionBook(state, bookPages)) return false;
+  Companion& c = state.companion;
+  c.todayPages = static_cast<uint16_t>(std::min(c.todayPages + newPages, 60000));
+  if (c.goalMetToday || c.todayPages < dailyGoal(tierOf(c.charId))) return false;
+  c.goalMetToday = true;
+  c.missed = 0;
+  c.ember = false;
+  if (c.streak < 60000) ++c.streak;
+  return true;
+}
+
+void chooseCompanion(State& state, const uint8_t id, const int32_t today) {
+  state.companion = Companion{};
+  state.companion.charId = id;
+  state.companion.day = today;
+  state.sleepChar = id;
+}
+
+Mood companionMood(const State& state) {
+  const Companion& c = state.companion;
+  if (c.charId == NO_CHAR) return c.leftCharId != NO_CHAR ? Mood::Left : Mood::None;
+  const bool behind = c.missed > 0 && !c.goalMetToday;
+  if (tierOf(c.charId) == Tier::Clay) return behind ? Mood::Hungry : Mood::Happy;
+  if (c.ember) return Mood::Ember;
+  return behind ? Mood::WeakTorch : Mood::Blessing;
+}
+
+// ---- Serialization ----
+
+namespace {
+constexpr uint8_t STATE_VERSION = 1;
+
+struct Writer {
+  uint8_t* out;
+  size_t cap;
+  size_t pos = 0;
+  bool ok = true;
+  void bytes(const void* p, const size_t n) {
+    if (pos + n > cap) {
+      ok = false;
+      return;
+    }
+    memcpy(out + pos, p, n);
+    pos += n;
+  }
+  void u8(const uint8_t v) { bytes(&v, 1); }
+  void u16(const uint16_t v) {
+    const uint8_t b[2] = {static_cast<uint8_t>(v), static_cast<uint8_t>(v >> 8)};
+    bytes(b, 2);
+  }
+  void u32(const uint32_t v) {
+    const uint8_t b[4] = {static_cast<uint8_t>(v), static_cast<uint8_t>(v >> 8), static_cast<uint8_t>(v >> 16),
+                          static_cast<uint8_t>(v >> 24)};
+    bytes(b, 4);
+  }
+};
+
+struct Reader {
+  const uint8_t* in;
+  size_t len;
+  size_t pos = 0;
+  bool ok = true;
+  void bytes(void* p, const size_t n) {
+    if (pos + n > len) {
+      ok = false;
+      memset(p, 0, n);
+      return;
+    }
+    memcpy(p, in + pos, n);
+    pos += n;
+  }
+  uint8_t u8() {
+    uint8_t v = 0;
+    bytes(&v, 1);
+    return v;
+  }
+  uint16_t u16() {
+    uint8_t b[2];
+    bytes(b, 2);
+    return static_cast<uint16_t>(b[0] | (b[1] << 8));
+  }
+  uint32_t u32() {
+    uint8_t b[4];
+    bytes(b, 4);
+    return b[0] | (b[1] << 8) | (b[2] << 16) | (static_cast<uint32_t>(b[3]) << 24);
+  }
+};
+
+uint32_t checksum(const uint8_t* p, const size_t n) {
+  uint32_t h = 2166136261u;
+  for (size_t i = 0; i < n; ++i) h = (h ^ p[i]) * 16777619u;
+  return h;
+}
+}  // namespace
+
+size_t serializeState(const State& state, uint8_t* out, const size_t cap) {
+  Writer w{out, cap};
+  w.bytes("OLY", 3);
+  w.u8(STATE_VERSION);
+  w.bytes(state.hatched, sizeof(state.hatched));
+  w.bytes(state.fresh, sizeof(state.fresh));
+  w.bytes(state.reserved, sizeof(state.reserved));
+  w.u32(static_cast<uint32_t>(state.lastDiscardMonth));
+  w.u8(state.sleepChar);
+  w.u32(state.rng);
+  const Companion& c = state.companion;
+  w.u8(c.charId);
+  w.u32(static_cast<uint32_t>(c.day));
+  w.u16(c.todayPages);
+  w.u8(c.missed);
+  w.u16(c.streak);
+  w.u8(c.goalMetToday ? 1 : 0);
+  w.u8(c.ember ? 1 : 0);
+  w.u8(c.leftCharId);
+  for (const auto& s : state.slots) {
+    w.u8(s.used ? 1 : 0);
+    w.u8(static_cast<uint8_t>(s.tier));
+    w.u8(s.charId);
+    w.u16(s.pages);
+    w.u16(s.readPages);
+    w.u32(static_cast<uint32_t>(s.lastReadDay));
+    const auto pathLen = static_cast<uint16_t>(std::min<size_t>(s.path.size(), 511));
+    w.u16(pathLen);
+    w.bytes(s.path.data(), pathLen);
+  }
+  if (!w.ok) return 0;
+  w.u32(checksum(out, w.pos));
+  return w.ok ? w.pos : 0;
+}
+
+bool deserializeState(State& state, const uint8_t* data, const size_t len) {
+  if (len < 8 || memcmp(data, "OLY", 3) != 0 || data[3] != STATE_VERSION) return false;
+  const size_t body = len - 4;
+  const uint32_t stored = data[body] | (data[body + 1] << 8) | (data[body + 2] << 16) |
+                          (static_cast<uint32_t>(data[body + 3]) << 24);
+  if (stored != checksum(data, body)) return false;
+  State s;
+  Reader r{data, body};
+  r.pos = 4;
+  r.bytes(s.hatched, sizeof(s.hatched));
+  r.bytes(s.fresh, sizeof(s.fresh));
+  r.bytes(s.reserved, sizeof(s.reserved));
+  s.lastDiscardMonth = static_cast<int32_t>(r.u32());
+  s.sleepChar = r.u8();
+  s.rng = r.u32();
+  Companion& c = s.companion;
+  c.charId = r.u8();
+  c.day = static_cast<int32_t>(r.u32());
+  c.todayPages = r.u16();
+  c.missed = r.u8();
+  c.streak = r.u16();
+  c.goalMetToday = r.u8() != 0;
+  c.ember = r.u8() != 0;
+  c.leftCharId = r.u8();
+  for (auto& slot : s.slots) {
+    slot.used = r.u8() != 0;
+    slot.tier = static_cast<Tier>(std::min<uint8_t>(r.u8(), 2));
+    slot.charId = r.u8();
+    slot.pages = r.u16();
+    slot.readPages = r.u16();
+    slot.lastReadDay = static_cast<int32_t>(r.u32());
+    const uint16_t pathLen = r.u16();
+    if (pathLen > 511) return false;
+    slot.path.resize(pathLen);
+    r.bytes(slot.path.data(), pathLen);
+  }
+  if (!r.ok || r.pos != body) return false;
+  state = std::move(s);
+  return true;
+}
+
+}  // namespace olympus
diff --git a/src/olympus/OlympusRules.h b/src/olympus/OlympusRules.h
new file mode 100644
index 00000000..dfebf472
--- /dev/null
+++ b/src/olympus/OlympusRules.h
@@ -0,0 +1,156 @@
+#pragma once
+// Olympus reading game: rules and saved state, free of hardware and UI so the
+// host tests can drive it. The device side (OlympusStore) owns file I/O, the
+// clock and the per-book page logs.
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace olympus {
+
+constexpr int TIER_COUNT = 3;
+constexpr int PER_TIER = 30;
+constexpr int TOTAL_CHARACTERS = TIER_COUNT * PER_TIER;
+constexpr int SLOT_COUNT = 3;
+constexpr uint8_t NO_CHAR = 0xFF;
+constexpr int32_t NO_DAY = -1;
+// Days without reading before an incubating egg frosts over.
+constexpr int COLD_EGG_DAYS = 7;
+// Missed days in a row before a creature leaves or a torch turns to embers.
+constexpr int MAX_MISSED_DAYS = 3;
+// Pages per food portion for clay companions.
+constexpr int PAGES_PER_FOOD = 5;
+// Inflated EPUB text bytes counted as one game page.
+constexpr int EPUB_BYTES_PER_PAGE = 2048;
+// Reading position (basis points) that counts as finishing the book: notes,
+// credits and back matter in the last 5% do not have to be paged through.
+constexpr int HATCH_AT_BP = 9500;
+
+enum class Tier : uint8_t { Clay = 0, Silver = 1, Gold = 2 };
+
+Tier tierForPages(int pages);
+int dailyGoal(Tier tier);
+inline Tier tierOf(const uint8_t charId) { return static_cast<Tier>(charId / PER_TIER); }
+inline int indexInTier(const uint8_t charId) { return charId % PER_TIER; }
+// 0 whole, 1 small crack (25%), 2 clear crack (50%), 3 shaking with eyes (75%).
+int crackStage(int readPages, int pages);
+
+// Game pages of an EPUB from its inflated spine size; at least 1.
+int pagesForEpubBytes(size_t bytes);
+
+// Which pages of one book have been seen. A page counts once, the first time
+// any reader page covering its middle is shown.
+class PageLog {
+ public:
+  void reset(int pages);
+  int pages() const { return pageCount; }
+  int readCount() const { return read; }
+  bool isRead(int page) const;
+  // Marks the game pages whose midpoints fall in [startBp, endBp) of the book
+  // (basis points, 0-10000), plus the page holding startBp. Returns how many
+  // pages were new.
+  int markSpan(int startBp, int endBp);
+
+  std::vector<uint8_t> serialize() const;
+  bool deserialize(const uint8_t* data, size_t len);
+
+ private:
+  int mark(int page);
+  int pageCount = 0;
+  int read = 0;
+  std::vector<uint8_t> bits;
+};
+
+struct Slot {
+  bool used = false;
+  Tier tier = Tier::Clay;
+  uint8_t charId = NO_CHAR;  // NO_CHAR: the tier was complete, the egg is empty
+  uint16_t pages = 0;
+  uint16_t readPages = 0;
+  int32_t lastReadDay = NO_DAY;
+  std::string path;
+};
+
+struct Companion {
+  uint8_t charId = NO_CHAR;
+  int32_t day = NO_DAY;  // the day todayPages belongs to
+  uint16_t todayPages = 0;
+  uint8_t missed = 0;    // missed days in a row, 0..MAX_MISSED_DAYS
+  uint16_t streak = 0;   // days in a row the goal was met
+  bool goalMetToday = false;
+  bool ember = false;    // silver/gold torch burned out
+  uint8_t leftCharId = NO_CHAR;  // clay companion that went back to the temple
+};
+
+struct State {
+  uint8_t hatched[12] = {};
+  uint8_t fresh[12] = {};     // hatched, profile not opened yet ("MỚI")
+  uint8_t reserved[12] = {};  // from discarded eggs; hatch from the next egg of their tier
+  Slot slots[SLOT_COUNT];
+  int32_t lastDiscardMonth = -1;
+  uint8_t sleepChar = NO_CHAR;
+  Companion companion;
+  uint32_t rng = 0x4F4C5950;
+
+  bool isHatched(uint8_t id) const;
+  bool isFresh(uint8_t id) const;
+  bool isReserved(uint8_t id) const;
+  int hatchedCount(Tier tier) const;
+  int totalHatched() const;
+  bool anyFresh() const;
+  bool phase2() const { return totalHatched() >= TOTAL_CHARACTERS; }
+  int usedSlots() const;
+  int slotForPath(const std::string& path) const;
+  // Character to sleep-screen: the companion in phase 2, else the chosen one.
+  uint8_t screenChar() const;
+};
+
+void setBit(uint8_t* bits, uint8_t id, bool on);
+bool getBit(const uint8_t* bits, uint8_t id);
+
+// Picks the character hidden in a new egg of `tier`: a reserved one first,
+// otherwise a random one that is neither hatched nor already in an egg.
+uint8_t pickCharacter(State& state, Tier tier);
+
+enum class PlaceResult : uint8_t { Placed, PlacedEmpty, AlreadyIncubating, Full, Closed, BadBook };
+PlaceResult placeBook(State& state, const std::string& path, int pages, int32_t today, int* slotOut = nullptr);
+
+// Discarding keeps the hidden character reserved for its tier. One per month;
+// month < 0 (clock unknown) is refused so the limit cannot be dodged.
+bool canDiscard(const State& state, int32_t month);
+bool discardSlot(State& state, int slot, int32_t month);
+
+struct HatchEvent {
+  bool hatched = false;
+  bool empty = false;  // the egg of a completed tier opened with nothing inside
+  uint8_t charId = NO_CHAR;
+  Tier tier = Tier::Clay;
+  bool tierCompleted = false;
+  bool allCompleted = false;
+  std::string bookPath;
+  uint16_t bookPages = 0;
+};
+
+// Records the incubating book's progress in `slot`: readPages is the reading
+// position in game pages (it follows the reader back and forth), newPages the
+// pages seen for the first time. The egg hatches when atLastPage is true, i.e.
+// while the book's final page is on screen.
+HatchEvent noteSlotPages(State& state, int slot, int newPages, int readPages, bool atLastPage, int32_t today);
+
+// Daily companion bookkeeping (phase 2). today < 0 means the clock is unknown.
+void rollover(State& state, int32_t today);
+// Pages read today from a book with `bookPages` pages. Returns true when this
+// read met the daily goal.
+bool noteCompanionPages(State& state, int bookPages, int newPages, int32_t today);
+void chooseCompanion(State& state, uint8_t id, int32_t today);
+bool isCompanionBook(const State& state, int bookPages);
+
+enum class Mood : uint8_t { Happy, Hungry, Left, Blessing, WeakTorch, Ember, None };
+Mood companionMood(const State& state);
+
+size_t serializeState(const State& state, uint8_t* out, size_t cap);
+bool deserializeState(State& state, const uint8_t* data, size_t len);
+constexpr size_t STATE_BUFFER_SIZE = 64 + SLOT_COUNT * (16 + 512);
+
+}  // namespace olympus
