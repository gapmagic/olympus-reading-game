+namespace olympus::draw {
+namespace {
+constexpr int W = 480;
+
+void plotTone(const GfxRenderer& r, const int x, const int y, const uint8_t tone) {
+  switch (tone) {
+    case 0:
+      r.drawPixel(x, y, true);
+      break;
+    case 1:
+      r.drawPixel(x, y, ((x + y) & 1) == 0);
+      break;
+    case 2:
+      r.drawPixel(x, y, (x & 1) == 0 && (y & 1) == 0);
+      break;
+    default:
+      break;
+  }
+}
+
+void fillCircle(const GfxRenderer& r, const int cx, const int cy, const int radius, const bool black = true) {
+  for (int dy = -radius; dy <= radius; ++dy) {
+    const int dx = static_cast<int>(std::sqrt(static_cast<float>(radius * radius - dy * dy)));
+    r.fillRect(cx - dx, cy + dy, 2 * dx + 1, 1, black);
+  }
+}
+
+void ring(const GfxRenderer& r, const int cx, const int cy, const int radius, const int width) {
+  fillCircle(r, cx, cy, radius, true);
+  fillCircle(r, cx, cy, radius - width, false);
+}
+
+}  // namespace
+
+void sprite(const GfxRenderer& r, const Sprite& s, const int x, const int y, const int size) {
+  if (size <= 0) return;
+  for (int dy = 0; dy < size; ++dy) {
+    const int sy = dy * s.height / size;
+    for (int dx = 0; dx < size; ++dx) {
+      plotTone(r, x + dx, y + dy, s.tone(dx * s.width / size, sy));
+    }
+  }
+}
+
+void silhouette(const GfxRenderer& r, const int x, const int y, const int size) {
+  // Head and shoulders on a pedestal, in the 96-unit grid of the sprites.
+  const auto u = [size](const int v) { return v * size / 96; };
+  for (int dy = 0; dy < size; ++dy) {
+    for (int dx = 0; dx < size; ++dx) {
+      const float fx = dx * 96.0f / size;
+      const float fy = dy * 96.0f / size;
+      const float hx = (fx - 48) / 28, hy = (fy - 33) / 27;
+      const bool head = hx * hx + hy * hy <= 1.0f;
+      const bool body = fy >= 56 && fy <= 86 && std::fabs(fx - 48) <= 14 + (fy - 56) * 8 / 30;
+      const float bx = (fx - 48) / 22, by = (fy - 84) / 6;
+      const bool base = bx * bx + by * by <= 1.0f;
+      if (head || body || base) plotTone(r, x + dx, y + dy, 1);
+    }
+  }
+  // Outline the head so the figure reads on dithered gray.
+  const int cx = x + u(48), cy = y + u(33), rad = u(28);
+  for (int a = 0; a < 360; a += 2) {
+    const float t = a * 3.14159f / 180;
+    r.fillRect(cx + static_cast<int>(rad * std::cos(t)) - 1, cy + static_cast<int>(rad * std::sin(t)) - 1, 2, 2, true);
+  }
+  const int font = size >= 120 ? NOTOSANS_18_FONT_ID : UI_12_FONT_ID;
+  const int lh = r.getLineHeight(font);
+  const int qw = r.getTextWidth(font, "?", EpdFontFamily::BOLD);
+  r.fillRect(cx - qw / 2 - 4, cy - lh / 2 - 2, qw + 8, lh + 4, false);
+  r.drawText(font, cx - qw / 2, cy - lh / 2, "?", true, EpdFontFamily::BOLD);
+}
+
+void character(const GfxRenderer& r, const uint8_t id, const int x, const int y, const int size) {
+  const Character& c = olympus::character(id);
+  if (const Sprite* art = sprites::characterArt(c.key)) {
+    sprite(r, *art, x, y, size);
+    return;
+  }
+  // No art yet: a light figure carrying the initial.
+  const auto u = [size](const int v) { return v * size / 96; };
+  for (int dy = 0; dy < size; ++dy) {
+    for (int dx = 0; dx < size; ++dx) {
+      const float fx = dx * 96.0f / size;
+      const float fy = dy * 96.0f / size;
+      const float hx = (fx - 48) / 28, hy = (fy - 33) / 27;
+      const bool head = hx * hx + hy * hy <= 1.0f;
+      const bool body = fy >= 56 && fy <= 86 && std::fabs(fx - 48) <= 14 + (fy - 56) * 8 / 30;
+      if (head || body) plotTone(r, x + dx, y + dy, 2);
+    }
+  }
+  const int cx = x + u(48), cy = y + u(33);
+  ring(r, cx, cy, u(28), std::max(2, size / 48));
+  const char initial[3] = {c.name[0], 0, 0};
+  const int font = size >= 120 ? NOTOSANS_18_FONT_ID : UI_12_FONT_ID;
+  const int lh = r.getLineHeight(font);
+  const int w = r.getTextWidth(font, initial, EpdFontFamily::BOLD);
+  r.fillRect(cx - w / 2 - 4, cy - lh / 2 - 2, w + 8, lh + 4, false);
+  r.drawText(font, cx - w / 2, cy - lh / 2, initial, true, EpdFontFamily::BOLD);
+}
+
+void egg(const GfxRenderer& r, const Tier tier, const int stage, const bool cold, const int x, const int y,
+         const int size) {
+  const int index = cold ? 5 : std::clamp(stage, 0, 4);
+  sprite(r, *sprites::eggs[static_cast<int>(tier)][index], x, y, size);
+}
+
+void logo(const GfxRenderer& r, const int x, const int y, const int size) {
+  sprite(r, size <= 48 ? sprites::spr_logo_icon_44 : sprites::spr_logo_96, x, y, size);
+}
+
+void meander(const GfxRenderer& r, const int y, const int x0, const int x1) {
+  constexpr int h = 10;
+  for (int x = x0; x + h <= x1; x += 2 * h) {
+    r.fillRect(x, y, 2, h + 1, true);          // up
+    r.fillRect(x, y, h + 1, 2, true);          // across
+    r.fillRect(x + h, y, 2, h + 1, true);      // down
+    r.fillRect(x + h, y + h - 1, h + 1, 2, true);  // along the bottom to the next unit
+  }
+}
+
+void bar(const GfxRenderer& r, const int x, const int y, const int w, const int h, const int perMille) {
+  r.drawRect(x, y, w, h, 2, true);
+  const int fill = (w - 6) * std::clamp(perMille, 0, 1000) / 1000;
+  if (fill > 0) r.fillRect(x + 3, y + 3, fill, h - 6, true);
+  for (const int q : {250, 500, 750}) r.fillRect(x + w * q / 1000 - 1, y + h + 2, 2, 5, true);
+}
+
+int pill(const GfxRenderer& r, const int fontId, const int x, const int y, const char* text, const bool inverted) {
+  const int tw = r.getTextWidth(fontId, text, EpdFontFamily::BOLD);
+  const int h = r.getLineHeight(fontId) + 6;
+  const int w = tw + 16;
+  if (inverted) {
+    r.fillRect(x, y, w, h, false);
+    r.drawRoundedRect(x, y, w, h, 2, h / 2, true);
+  } else {
+    r.fillRoundedRect(x, y, w, h, h / 2, Color::Black);
+  }
+  r.drawText(fontId, x + 8, y + 3, text, inverted, EpdFontFamily::BOLD);
+  return w;
+}
+
+int wrap(const GfxRenderer& r, const int fontId, const int x, const int y, const int w, const char* text,
+         const int maxLines, const bool black, const bool bold) {
+  const auto style = bold ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR;
+  const int lh = r.getLineHeight(fontId);
+  int yy = y;
+  for (const auto& line : r.wrappedText(fontId, text, w, maxLines, style)) {
+    r.drawText(fontId, x, yy, line.c_str(), black, style);
+    yy += lh;
+  }
+  return yy;
+}
+
+void centered(const GfxRenderer& r, const int fontId, const int cx, const int y, const char* text, const bool black,
+              const bool bold) {
+  const auto style = bold ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR;
+  r.drawText(fontId, cx - r.getTextWidth(fontId, text, style) / 2, y, text, black, style);
+}
