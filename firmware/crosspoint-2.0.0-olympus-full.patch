+std::string bookCachePath(const std::string& path) {
+  const char* prefix = nullptr;
+  if (FsHelpers::hasReflowableBookExtension(path)) {
+    prefix = "epub_";
+  } else if (FsHelpers::hasXtcExtension(path)) {
+    prefix = "xtc_";
