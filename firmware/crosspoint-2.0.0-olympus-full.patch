+
+int LibraryListActivity::percentFor(const int entry, const uint64_t pathHash, int* incubating) {
+  if (incubating) *incubating = -1;
+  if (pathHash == 0) return -1;
+  for (const auto& slot : percentSlots) {
+    if (slot.used && slot.pathHash == pathHash) {
+      if (incubating) *incubating = slot.incubating;
+      return slot.percent;
+    }
+  }
+  std::string path;
+  const bool havePath = rowPathFor(entry, path);
+  const int percent = havePath ? loadSavedBookPercent(path) : -1;
+  int egg = -1;
+  if (havePath) {
+    const auto& game = olympus::store().state();
+    const int eggSlot = game.slotForPath(path);
+    if (eggSlot >= 0) {
+      const auto& slot = game.slots[eggSlot];
+      egg = slot.pages ? std::min(100, slot.readPages * 100 / slot.pages) : 0;
+    }
+  }
+  if (incubating) *incubating = egg;
+  percentSlots[nextPercentSlot] = {pathHash, static_cast<int8_t>(percent), static_cast<int8_t>(egg), true};
+  nextPercentSlot = static_cast<uint8_t>((nextPercentSlot + 1) % PERCENT_SLOTS);
+  return percent;
+}
