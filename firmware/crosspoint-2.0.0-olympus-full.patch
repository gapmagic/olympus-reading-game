+#pragma once
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "activities/Activity.h"
+#include "olympus/OlympusRules.h"
+
+// The Olympus reading game: hub, incubator, temple, character profiles, the
+// companion and the hatch screens. One activity with its own screen stack, so
+// Back always returns to the previous Olympus screen.
+class OlympusActivity final : public Activity {
+ public:
+  // Opened from Home.
+  OlympusActivity(GfxRenderer& renderer, MappedInputManager& mappedInput);
+  // Opened over the reader for a hatch; every Back returns to the book.
+  OlympusActivity(GfxRenderer& renderer, MappedInputManager& mappedInput, const olympus::HatchEvent& hatch);
+
+  void onEnter() override;
+  void loop() override;
+  void render(RenderLock&&) override;
+
+ private:
