+int loadSavedBookPercent(const std::string& path) {
+  const std::string cachePath = bookCachePath(path);
+  if (cachePath.empty()) return -1;
+  HalFile file;
+  if (!Storage.openFileForRead("PCT", cachePath + "/" + PERCENT_FILE, file)) return -1;
+  uint8_t value = 0;
+  if (file.read(&value, 1) != 1 || value > 100) return -1;
+  return value;
+}
+
+void saveBookPercent(const std::string& path, const int percent) {
+  const std::string cachePath = bookCachePath(path);
+  if (cachePath.empty() || percent < 0 || percent > 100) return;
+  // The reader created this folder when it saved the position; never create it here.
+  if (!Storage.exists(cachePath.c_str())) return;
+  // Most exits (sleep included) leave the percent unchanged; skip the card write.
+  if (loadSavedBookPercent(path) == percent) return;
+  const uint8_t value = static_cast<uint8_t>(percent);
+  if (!ProgressFile::writeAtomic(cachePath, PERCENT_FILE, &value, 1)) {
+    LOG_ERR("PCT", "Could not save percent for %s", path.c_str());
+  }
+}
