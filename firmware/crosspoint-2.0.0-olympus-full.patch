+// ---------------- Rendering ----------------
+
+void OlympusActivity::drawHints(const char* backLabel, const char* confirm, const char* previous, const char* next) {
+  if (mappedInput.hasTouch()) {
+    // No front buttons and no theme hint bar on touch boards: draw tappable buttons instead.
+    // Navigation is by tapping content, swiping and the Home key; only the profile keeps its one
+    // action (set as sleep screen / choose companion) as a button, since it has no other target.
+    for (auto& r : barRects) r = Rect{};
+    // Incubator, temple and profile keep a Back button; the hub has none (Home key).
+    const Screen s = current();
+    if (s == Screen::Hub) return;
+    const bool list = s == Screen::Incubator || s == Screen::Temple;
+    const bool profile = s == Screen::Profile;
+    const char* labels[4] = {backLabel, list ? nullptr : confirm, (list || profile) ? nullptr : previous,
+                             (list || profile) ? nullptr : next};
+    int count = 0;
+    for (const char* l : labels) count += (l && l[0]) ? 1 : 0;
+    for (auto& r : barRects) r = Rect{};
+    if (count == 0) return;
+    constexpr int gap = 8, y = 752, h = 42;
+    const int bw = count == 1 ? 160 : (W - 16 - (count - 1) * gap) / count;
+    int bx = count == 1 ? (W - bw) / 2 : 8;
+    for (int i = 0; i < 4; ++i) {
+      if (!labels[i] || !labels[i][0]) continue;
+      const bool primary = i == 1;
+      if (primary) {
+        renderer.fillRoundedRect(bx, y, bw, h, 8, Color::Black);
+      } else {
+        renderer.drawRoundedRect(bx, y, bw, h, 2, 8, true);
+      }
+      const std::string text = renderer.truncatedText(UI_10_FONT_ID, labels[i], bw - 12, EpdFontFamily::BOLD);
+      draw::centered(renderer, UI_10_FONT_ID, bx + bw / 2, y + 9, text.c_str(), !primary, true);
+      barRects[i] = Rect{bx, y - 6, bw, h + 12};
+      bx += bw + gap;
+    }
+    return;
+  }
+  const auto labels = mappedInput.mapLabels(backLabel, confirm, previous, next);
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+}
+
+void OlympusActivity::render(RenderLock&&) {
+  renderer.clearScreen();
+  switch (current()) {
+    case Screen::Hub:
+      renderHub();
+      break;
+    case Screen::Incubator:
+      renderIncubator();
+      break;
+    case Screen::Temple:
+      renderTemple();
+      break;
+    case Screen::Profile:
+      renderProfile();
+      break;
+    case Screen::Hatch:
+      renderHatch();
+      break;
+    case Screen::TierComplete:
+      renderTierComplete();
+      break;
+    case Screen::Companion:
+      draw::statusScreen(renderer, false);
+      drawHints(OLY_T("Quay lại", "Back"), OLY_T("Đền thờ", "Temple"), "", "");
+      break;
+  }
+  if (modal.active) renderModal();
+  renderer.displayBuffer(firstRender ? HalDisplay::HALF_REFRESH : HalDisplay::FAST_REFRESH);
+  firstRender = false;
+}
