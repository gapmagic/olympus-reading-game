+      dashedRect(renderer, 24, y, W - 48, 206);
+      if (selected) renderer.drawRoundedRect(20, y - 4, W - 40, 214, 2, 10, true);
+      draw::centered(renderer, NOTOSANS_18_FONT_ID, W / 2, y + 50, "+", true, true);
+      draw::centered(renderer, UI_10_FONT_ID, W / 2, y + 110, OLY_T("Ô trống · Đặt sách vào lò ấp", "Empty slot · Add a book"), true, true);
+      draw::centered(renderer, SMALL_FONT_ID, W / 2, y + 140,
