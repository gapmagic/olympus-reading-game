+bool OlympusActivity::released(const Button b) const {
+  return mappedInput.wasReleased(b) || virtualButton == static_cast<int>(b);
+}
+
+bool OlympusActivity::pressed(const Button b) const {
+  return mappedInput.wasPressed(b) || virtualButton == static_cast<int>(b);
