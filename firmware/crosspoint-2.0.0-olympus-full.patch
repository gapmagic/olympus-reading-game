+#include <gtest/gtest.h>
+
+#include <cstring>
+#include <set>
+#include <string>
+
+#include "olympus/OlympusRoster.h"
+#include "olympus/OlympusRules.h"
+
+using namespace olympus;
+
+namespace {
+// Reads a whole book one reader page at a time, `readerPages` pages in all.
+int readThrough(PageLog& log, const int readerPages) {
+  int added = 0;
+  for (int p = 0; p < readerPages; ++p) {
+    added += log.markSpan(p * 10000 / readerPages, (p + 1) * 10000 / readerPages);
+  }
+  return added;
+}
+
+void hatchAll(State& s, const Tier tier) {
+  for (int i = 0; i < PER_TIER; ++i) setBit(s.hatched, static_cast<uint8_t>(static_cast<int>(tier) * PER_TIER + i), true);
+}
+}  // namespace
+
+TEST(OlympusTiers, PageThresholds) {
+  EXPECT_EQ(tierForPages(1), Tier::Clay);
+  EXPECT_EQ(tierForPages(200), Tier::Clay);
+  EXPECT_EQ(tierForPages(201), Tier::Silver);
+  EXPECT_EQ(tierForPages(499), Tier::Silver);
+  EXPECT_EQ(tierForPages(500), Tier::Gold);
+  EXPECT_EQ(dailyGoal(Tier::Clay), 5);
+  EXPECT_EQ(dailyGoal(Tier::Silver), 10);
+  EXPECT_EQ(dailyGoal(Tier::Gold), 20);
+}
+
+TEST(OlympusTiers, CrackStages) {
+  EXPECT_EQ(crackStage(0, 100), 0);
+  EXPECT_EQ(crackStage(24, 100), 0);
+  EXPECT_EQ(crackStage(25, 100), 1);
+  EXPECT_EQ(crackStage(50, 100), 2);
+  EXPECT_EQ(crackStage(75, 100), 3);
+  EXPECT_EQ(crackStage(100, 100), 3);
+}
+
+TEST(OlympusPageLog, SequentialReadingCoversEveryPage) {
+  for (const int gamePages : {1, 7, 112, 443, 1225}) {
+    for (const int readerPages : {3, 50, 300, 2000}) {
+      PageLog log;
+      log.reset(gamePages);
+      EXPECT_EQ(readThrough(log, readerPages), gamePages) << gamePages << " " << readerPages;
+      EXPECT_EQ(log.readCount(), gamePages);
+    }
+  }
+}
+
+TEST(OlympusPageLog, RereadingCountsNothing) {
+  PageLog log;
+  log.reset(100);
+  EXPECT_EQ(log.markSpan(0, 500), 5);
+  EXPECT_EQ(log.markSpan(0, 500), 0);
+  EXPECT_EQ(log.markSpan(200, 300), 0);
+}
+
+TEST(OlympusPageLog, JumpCountsOnlyLandingPage) {
+  PageLog log;
+  log.reset(100);
+  EXPECT_EQ(log.markSpan(9000, 9000), 1);
+  EXPECT_TRUE(log.isRead(90));
+  EXPECT_EQ(log.readCount(), 1);
+}
+
+TEST(OlympusPageLog, RoundTrip) {
+  PageLog log;
+  log.reset(333);
+  log.markSpan(1000, 4000);
+  const auto bytes = log.serialize();
+  PageLog copy;
+  ASSERT_TRUE(copy.deserialize(bytes.data(), bytes.size()));
+  EXPECT_EQ(copy.pages(), 333);
+  EXPECT_EQ(copy.readCount(), log.readCount());
+  EXPECT_FALSE(copy.deserialize(bytes.data(), bytes.size() - 1));
+}
+
+TEST(OlympusIncubator, PlacesUpToThreeBooks) {
+  State s;
+  EXPECT_EQ(placeBook(s, "/a.epub", 120, 10), PlaceResult::Placed);
+  EXPECT_EQ(placeBook(s, "/a.epub", 120, 10), PlaceResult::AlreadyIncubating);
+  EXPECT_EQ(placeBook(s, "/b.epub", 300, 10), PlaceResult::Placed);
+  EXPECT_EQ(placeBook(s, "/c.epub", 900, 10), PlaceResult::Placed);
+  EXPECT_EQ(placeBook(s, "/d.epub", 900, 10), PlaceResult::Full);
+  EXPECT_EQ(s.slots[0].tier, Tier::Clay);
+  EXPECT_EQ(s.slots[1].tier, Tier::Silver);
+  EXPECT_EQ(s.slots[2].tier, Tier::Gold);
+  EXPECT_EQ(tierOf(s.slots[1].charId), Tier::Silver);
+}
+
+TEST(OlympusIncubator, EggFollowsPositionAndHatchesAtTheEnd) {
+  State s;
+  int slot = -1;
+  ASSERT_EQ(placeBook(s, "/a.epub", 100, 10, &slot), PlaceResult::Placed);
+  const uint8_t hidden = s.slots[slot].charId;
+  EXPECT_FALSE(noteSlotPages(s, slot, 70, 70, false, 11).hatched);
+  EXPECT_EQ(s.slots[slot].readPages, 70);
+  EXPECT_FALSE(noteSlotPages(s, slot, 0, 40, false, 11).hatched);  // jumped back
+  EXPECT_EQ(s.slots[slot].readPages, 40);
+  const HatchEvent e = noteSlotPages(s, slot, 0, 100, true, 12);  // jumped to the end
+  ASSERT_TRUE(e.hatched);
+  EXPECT_EQ(e.charId, hidden);
+  EXPECT_TRUE(s.isHatched(hidden));
+  EXPECT_TRUE(s.isFresh(hidden));
+  EXPECT_FALSE(s.slots[slot].used);
+}
+
+TEST(OlympusIncubator, NeverHatchesTheSameCharacterTwice) {
+  State s;
+  std::vector<int> seen(TOTAL_CHARACTERS, 0);
+  for (int i = 0; i < PER_TIER; ++i) {
+    int slot = -1;
+    ASSERT_EQ(placeBook(s, "/book" + std::to_string(i), 300, 1, &slot), PlaceResult::Placed);
+    const HatchEvent e = noteSlotPages(s, slot, 300, 300, true, 1);
+    ASSERT_TRUE(e.hatched);
+    ++seen[e.charId];
+    EXPECT_EQ(e.tierCompleted, i == PER_TIER - 1);
+  }
+  for (int i = PER_TIER; i < 2 * PER_TIER; ++i) EXPECT_EQ(seen[i], 1);
+  EXPECT_EQ(placeBook(s, "/extra", 300, 1), PlaceResult::PlacedEmpty);
+}
+
+TEST(OlympusIncubator, DiscardReservesCharacterAnyTime) {
+  State s;
+  int slot = -1;
+  placeBook(s, "/a", 50, 1, &slot);
+  const uint8_t hidden = s.slots[slot].charId;
+  EXPECT_TRUE(discardSlot(s, slot, -1));  // works without a clock
+  EXPECT_TRUE(s.isReserved(hidden));
+  placeBook(s, "/c", 50, 1, &slot);
+  EXPECT_EQ(s.slots[slot].charId, hidden);
+  EXPECT_TRUE(discardSlot(s, slot, 24300));
+  EXPECT_TRUE(s.isReserved(hidden));
+  placeBook(s, "/b", 60, 1, &slot);
+  EXPECT_EQ(s.slots[slot].charId, hidden);
+  EXPECT_FALSE(s.isReserved(hidden));
+  EXPECT_TRUE(discardSlot(s, slot, 24300));  // again in the same month
+  EXPECT_FALSE(discardSlot(s, slot, 24300));  // slot is empty now
+}
+
+TEST(OlympusIncubator, ClosesAtNinety) {
+  State s;
+  hatchAll(s, Tier::Clay);
+  hatchAll(s, Tier::Silver);
+  for (int i = 0; i < PER_TIER - 1; ++i) setBit(s.hatched, static_cast<uint8_t>(2 * PER_TIER + i), true);
+  int slot = -1;
+  ASSERT_EQ(placeBook(s, "/big", 800, 1, &slot), PlaceResult::Placed);
+  placeBook(s, "/small", 80, 1);
+  const HatchEvent e = noteSlotPages(s, slot, 800, 800, true, 1);
+  EXPECT_TRUE(e.allCompleted);
+  EXPECT_TRUE(s.phase2());
+  EXPECT_EQ(s.usedSlots(), 0);
+  EXPECT_EQ(placeBook(s, "/more", 80, 1), PlaceResult::Closed);
+}
+
+TEST(OlympusCompanion, CreatureLeavesAfterThreeMissedDays) {
+  State s;
+  chooseCompanion(s, 0, 100);  // a clay creature
+  EXPECT_TRUE(noteCompanionPages(s, 150, 5, 100));
+  EXPECT_EQ(companionMood(s), Mood::Happy);
+  EXPECT_EQ(s.companion.streak, 1);
+  EXPECT_FALSE(noteCompanionPages(s, 300, 50, 101));  // silver-size book: does not count
+  rollover(s, 102);
+  EXPECT_EQ(s.companion.missed, 1);
+  EXPECT_EQ(companionMood(s), Mood::Hungry);
+  rollover(s, 103);
+  EXPECT_EQ(s.companion.missed, 2);
+  rollover(s, 104);
+  EXPECT_EQ(companionMood(s), Mood::Left);
+  EXPECT_EQ(s.companion.leftCharId, 0);
+}
+
+TEST(OlympusCompanion, ReadingResetsMissedDays) {
+  State s;
+  chooseCompanion(s, 1, 10);
+  rollover(s, 12);  // day 10 and 11 missed
+  EXPECT_EQ(s.companion.missed, 2);
+  EXPECT_TRUE(noteCompanionPages(s, 100, 6, 12));
+  EXPECT_EQ(s.companion.missed, 0);
+  EXPECT_EQ(companionMood(s), Mood::Happy);
+}
+
+TEST(OlympusCompanion, TorchTurnsToEmbersAndRelights) {
+  State s;
+  chooseCompanion(s, PER_TIER + 2, 10);  // a silver god
+  for (int d = 10; d < 15; ++d) EXPECT_TRUE(noteCompanionPages(s, 300, 10, d));
+  EXPECT_EQ(s.companion.streak, 5);
+  EXPECT_EQ(companionMood(s), Mood::Blessing);
+  rollover(s, 16);
+  EXPECT_EQ(companionMood(s), Mood::WeakTorch);
+  rollover(s, 18);
+  EXPECT_EQ(companionMood(s), Mood::Ember);
+  EXPECT_EQ(s.companion.streak, 0);
+  EXPECT_FALSE(noteCompanionPages(s, 300, 9, 18));
+  EXPECT_TRUE(noteCompanionPages(s, 300, 1, 18));
+  EXPECT_EQ(companionMood(s), Mood::Blessing);
+  EXPECT_EQ(s.companion.streak, 1);
+}
+
+TEST(OlympusCompanion, GoldNeedsTwentyPagesFromBigBooks) {
+  State s;
+  chooseCompanion(s, 2 * PER_TIER, 1);
+  EXPECT_FALSE(noteCompanionPages(s, 499, 30, 1));
+  EXPECT_FALSE(noteCompanionPages(s, 600, 19, 1));
+  EXPECT_TRUE(noteCompanionPages(s, 600, 1, 1));
+}
+
+TEST(OlympusState, RoundTrip) {
+  State s;
+  placeBook(s, "/Books/Sapiens.epub", 443, 20000);
+  placeBook(s, "/Books/Hoàng tử bé.epub", 112, 20001);
+  setBit(s.hatched, 5, true);
+  setBit(s.fresh, 5, true);
+  s.sleepChar = 5;
+  s.lastDiscardMonth = 24310;
+  chooseCompanion(s, 40, 20002);
+  s.companion.todayPages = 7;
+  uint8_t buf[STATE_BUFFER_SIZE];
+  const size_t n = serializeState(s, buf, sizeof(buf));
+  ASSERT_GT(n, 0u);
+  State copy;
+  ASSERT_TRUE(deserializeState(copy, buf, n));
+  EXPECT_EQ(copy.slots[1].path, "/Books/Hoàng tử bé.epub");
+  EXPECT_EQ(copy.slots[0].pages, 443);
+  EXPECT_EQ(copy.slots[0].charId, s.slots[0].charId);
+  EXPECT_TRUE(copy.isFresh(5));
+  EXPECT_EQ(copy.companion.charId, 40);
+  EXPECT_EQ(copy.companion.todayPages, 7);
+  EXPECT_EQ(copy.lastDiscardMonth, 24310);
+  buf[10] ^= 1;
+  EXPECT_FALSE(deserializeState(copy, buf, n));
+}
+
+TEST(OlympusRoster, NinetyDistinctCompleteEntries) {
+  std::set<std::string> names;
+  for (int i = 0; i < TOTAL_CHARACTERS; ++i) {
+    const Character& c = character(static_cast<uint8_t>(i));
+    ASSERT_NE(c.key, nullptr) << i;
+    for (const char* field : {c.name, c.origin, c.ability, c.symbols, c.myth, c.hint}) {
+      ASSERT_NE(field, nullptr) << i;
+      EXPECT_GT(strlen(field), 2u) << i;
+    }
+    ASSERT_NE(c.blessing, nullptr);
+    // Creatures have a quote shown when fed; gods and Titans a blessing.
+    EXPECT_GT(strlen(c.blessing), 10u) << c.name;
+    names.insert(c.name);
+  }
+  EXPECT_EQ(names.size(), static_cast<size_t>(TOTAL_CHARACTERS));
+  // Numbers shown in the approved mock-ups.
+  EXPECT_STREQ(character(PER_TIER + 0).name, "Zeus");
+  EXPECT_STREQ(character(PER_TIER + 2).name, "Poseidon");
+  EXPECT_STREQ(character(2 * PER_TIER + 2).name, "Kronos");
+}
+
+TEST(OlympusCompanion, SleepCharacterIsCompanionBeforeAllAreHatched) {
+  State s;
+  int slot = -1;
+  ASSERT_EQ(placeBook(s, "/a.epub", 100, 1, &slot), PlaceResult::Placed);
+  const HatchEvent e = noteSlotPages(s, slot, 0, 100, true, 1);
+  ASSERT_TRUE(e.hatched);
+  ASSERT_FALSE(s.phase2());
+  chooseCompanion(s, e.charId, 2);
+  EXPECT_EQ(s.screenChar(), e.charId);
+  EXPECT_TRUE(noteCompanionPages(s, 100, dailyGoal(Tier::Clay), 2));
+  EXPECT_TRUE(s.companion.goalMetToday);
+  EXPECT_EQ(s.companion.streak, 1);
+}
