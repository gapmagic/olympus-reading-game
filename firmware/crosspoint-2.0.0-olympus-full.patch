+void LibraryListActivity::promptIncubate(const std::string& path, const std::string& title) {
+  auto& game = olympus::store();
+  const auto& state = game.state();
+  if (state.phase2()) {
+    showLibraryMessage(OLY_T("Lò ấp đã đóng", "Incubator closed"), OLY_T("Bạn đã sưu tầm đủ 90/90 nhân vật. Vào Olympus để nuôi bạn đồng hành.", "You have collected all 90/90 characters. Open Olympus to care for your companion."));
+    return;
+  }
+  if (state.slotForPath(path) >= 0) {
+    showLibraryMessage(OLY_T("Đang ấp", "Incubating"), OLY_T("Cuốn này đã ở trong lò ấp.", "This book is already in the incubator."));
