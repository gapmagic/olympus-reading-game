diff --git a/scripts/olympus_sprites.py b/scripts/olympus_sprites.py
new file mode 100644
index 00000000..bf538470
--- /dev/null
+++ b/scripts/olympus_sprites.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Packs the Olympus 4-tone PNG sprites into src/olympus/OlympusSprites.h.
+
+Usage: olympus_sprites.py <sprite_dir>[:<more_dirs>...] src/olympus/OlympusSprites.h
+A sprite is taken from the first directory that has it.
+Also writes src/components/icons/olympus.h (the Home menu icon).
+Each pixel becomes 2 bits (0 black, 1 dark gray, 2 light gray, 3 white),
+four pixels per byte, most significant pair first, rows unpadded.
+"""
+import os
+import sys
+
+from PIL import Image
+
+TONES = [0, 96, 176, 255]
+# All 90 characters, in roster order (ids 0-29 clay, 30-59 silver, 60-89 gold).
+CHARACTERS = ["pegasus", "cerberus", "glaux", "dryad", "satyr", "cyclops", "chiron", "gryps", "hydra", "chimaera",
+              "sphinx", "minotaurus", "medusa", "harpyia", "seiren", "nereis", "naias", "pan", "echo", "phoenix",
+              "ladon", "orthrus", "leo", "triton", "scylla", "argus", "talos", "cetus", "hippocampus", "arion",
+              "zeus", "hera", "poseidon", "athena", "apollo", "artemis", "demeter", "ares", "aphrodite", "hermes",
+              "hephaestus", "dionysus", "hades", "hestia", "persephone", "hecate", "eros", "nike", "iris", "hebe",
+              "asclepius", "morpheus", "hypnos", "thanatos", "nemesis", "tyche", "calliope", "clio", "harmonia",
+              "eileithyia",
+              "chaos", "gaia", "kronos", "atlas", "prometheus", "selene", "nyx", "ouranos", "rhea", "oceanus",
+              "tethys", "hyperion", "theia", "coeus", "phoebe", "crius", "iapetus", "mnemosyne", "themis",
+              "epimetheus", "helios", "eos", "erebus", "aether", "hemera", "tartarus", "pontus", "ananke", "chronos",
+              "metis"]
+EXTRA = ([f"egg_{t}_{s}" for t in ("clay", "silver", "gold") for s in ("0", "1", "2", "3", "4", "cold")] +
+         ["flame_0", "flame_1", "flame_2", "food_olive", "food_honey", "food_apple", "food_ambrosia", "logo_96",
+          "logo_icon_44", "offer_bowl_full", "offer_bowl_empty", "offer_bowl_tipped"])
+
+
+def pack(path):
+    im = Image.open(path).convert("L")
+    w, h = im.size
+    px = im.load()
+    out = bytearray()
+    acc = 0
+    n = 0
+    for y in range(h):
+        for x in range(w):
+            v = px[x, y]
+            tone = min(range(4), key=lambda i: abs(TONES[i] - v))
+            acc = (acc << 2) | tone
+            n += 1
+            if n == 4:
+                out.append(acc)
+                acc = 0
+                n = 0
+    if n:
+        out.append(acc << (2 * (4 - n)))
+    return w, h, bytes(out)
+
+
+def menu_icon(src):
+    im = Image.open(os.path.join(src, "logo_96.png")).convert("L").resize((32, 32), Image.LANCZOS)
+    px = im.load()
+    out = bytearray()
+    for row in range(32):  # drawIcon plots stored (row, col) at screen (31 - row, col)
+        for byte in range(4):
+            v = 0
+            for bit in range(8):
+                col = byte * 8 + bit
+                white = px[31 - row, col] >= 150
+                v = (v << 1) | (1 if white else 0)
+            out.append(v)
+    return bytes(out)
+
+
+def ident(name):
+    return "spr_" + name
+
+
+def main():
+    dirs, dst = sys.argv[1].split(os.pathsep), sys.argv[2]
+    src = dirs[0]
+
+    def find(name):
+        for d in dirs:
+            path = os.path.join(d, name + ".png")
+            if os.path.exists(path):
+                return path
+        sys.exit(f"missing sprite: {name}.png")
+    lines = ["#pragma once", "// Generated by scripts/olympus_sprites.py. Do not edit.", "#include <cstdint>", "",
+             "#include \"olympus/OlympusSprite.h\"", "", "namespace olympus::sprites {", ""]
+    for name in CHARACTERS + EXTRA:
+        w, h, data = pack(find(name))
+        body = ",".join(str(b) for b in data)
+        lines.append(f"inline constexpr uint8_t {ident(name)}_px[] = {{{body}}};")
+        lines.append(f"inline constexpr Sprite {ident(name)}{{{w}, {h}, {ident(name)}_px}};")
+    lines.append("")
+    lines.append("// Character art by key; nullptr when the character has no art yet.")
+    lines.append("inline const Sprite* characterArt(const char* key) {")
+    lines.append("  struct Entry { const char* key; const Sprite* sprite; };")
+    lines.append("  static constexpr Entry table[] = {" + ", ".join(f"{{\"{c}\", &{ident(c)}}}" for c in CHARACTERS) + "};")
+    lines.append("  for (const auto& e : table) {")
+    lines.append("    const char* a = e.key; const char* b = key;")
+    lines.append("    while (*a && *a == *b) { ++a; ++b; }")
+    lines.append("    if (*a == *b) return e.sprite;")
+    lines.append("  }")
+    lines.append("  return nullptr;")
+    lines.append("}")
+    lines.append("")
+    lines.append("inline constexpr const Sprite* eggs[3][6] = {")
+    for t in ("clay", "silver", "gold"):
+        lines.append("    {" + ", ".join(f"&{ident(f'egg_{t}_{s}')}" for s in ("0", "1", "2", "3", "4", "cold")) + "},")
+    lines.append("};")
+    lines.append("inline constexpr const Sprite* flames[3] = {&spr_flame_0, &spr_flame_1, &spr_flame_2};")
+    lines.append("// Offering bowl on a creature's altar: full (fed), empty (waiting), tipped over (left).")
+    lines.append("inline constexpr const Sprite* bowls[3] = {&spr_offer_bowl_full, &spr_offer_bowl_empty, "
+                 "&spr_offer_bowl_tipped};")
+    lines.append("inline constexpr const Sprite* foods[4] = {&spr_food_olive, &spr_food_honey, &spr_food_apple, "
+                 "&spr_food_ambrosia};")
+    lines.append("")
+    lines.append("}  // namespace olympus::sprites")
+
+    with open(dst, "w") as f:
+        f.write("\n".join(lines) + "\n")
+    icon = os.path.join(os.path.dirname(dst), "..", "components", "icons", "olympus.h")
+    with open(icon, "w") as f:
+        f.write("#pragma once\n// Generated by scripts/olympus_sprites.py. Do not edit.\n#include <cstdint>\n\n"
+                "// size: 32x32, GfxRenderer::drawIcon layout\n"
+                "static const uint8_t OlympusIcon[] = {" + ",".join(str(b) for b in menu_icon(src)) + "};\n")
+
+
+if __name__ == "__main__":
+    main()
