diff --git a/src/olympus/OlympusDraw.cpp b/src/olympus/OlympusDraw.cpp
new file mode 100644
index 00000000..f5135c13
--- /dev/null
+++ b/src/olympus/OlympusDraw.cpp
@@ -0,0 +1,425 @@
+#include "OlympusDraw.h"
+#include "OlympusLang.h"
+
+#include <GfxRenderer.h>
+
+#include <algorithm>
+#include <cstring>
+#include <cmath>
+#include <cstdio>
+
+#include "OlympusRoster.h"
+#include "OlympusSprites.h"
+#include "OlympusStore.h"
+#include "fontIds.h"
+
+namespace olympus::draw {
+namespace {
+constexpr int W = 480;
+
+void plotTone(const GfxRenderer& r, const int x, const int y, const uint8_t tone) {
+  switch (tone) {
+    case 0:
+      r.drawPixel(x, y, true);
+      break;
+    case 1:
+      r.drawPixel(x, y, ((x + y) & 1) == 0);
+      break;
+    case 2:
+      r.drawPixel(x, y, (x & 1) == 0 && (y & 1) == 0);
+      break;
+    default:
+      break;
+  }
+}
+
+void fillCircle(const GfxRenderer& r, const int cx, const int cy, const int radius, const bool black = true) {
+  for (int dy = -radius; dy <= radius; ++dy) {
+    const int dx = static_cast<int>(std::sqrt(static_cast<float>(radius * radius - dy * dy)));
+    r.fillRect(cx - dx, cy + dy, 2 * dx + 1, 1, black);
+  }
+}
+
+void ring(const GfxRenderer& r, const int cx, const int cy, const int radius, const int width) {
+  fillCircle(r, cx, cy, radius, true);
+  fillCircle(r, cx, cy, radius - width, false);
+}
+
+}  // namespace
+
+void sprite(const GfxRenderer& r, const Sprite& s, const int x, const int y, const int size) {
+  if (size <= 0) return;
+  for (int dy = 0; dy < size; ++dy) {
+    const int sy = dy * s.height / size;
+    for (int dx = 0; dx < size; ++dx) {
+      plotTone(r, x + dx, y + dy, s.tone(dx * s.width / size, sy));
+    }
+  }
+}
+
+void silhouette(const GfxRenderer& r, const int x, const int y, const int size) {
+  // Head and shoulders on a pedestal, in the 96-unit grid of the sprites.
+  const auto u = [size](const int v) { return v * size / 96; };
+  for (int dy = 0; dy < size; ++dy) {
+    for (int dx = 0; dx < size; ++dx) {
+      const float fx = dx * 96.0f / size;
+      const float fy = dy * 96.0f / size;
+      const float hx = (fx - 48) / 28, hy = (fy - 33) / 27;
+      const bool head = hx * hx + hy * hy <= 1.0f;
+      const bool body = fy >= 56 && fy <= 86 && std::fabs(fx - 48) <= 14 + (fy - 56) * 8 / 30;
+      const float bx = (fx - 48) / 22, by = (fy - 84) / 6;
+      const bool base = bx * bx + by * by <= 1.0f;
+      if (head || body || base) plotTone(r, x + dx, y + dy, 1);
+    }
+  }
+  // Outline the head so the figure reads on dithered gray.
+  const int cx = x + u(48), cy = y + u(33), rad = u(28);
+  for (int a = 0; a < 360; a += 2) {
+    const float t = a * 3.14159f / 180;
+    r.fillRect(cx + static_cast<int>(rad * std::cos(t)) - 1, cy + static_cast<int>(rad * std::sin(t)) - 1, 2, 2, true);
+  }
+  const int font = size >= 120 ? NOTOSANS_18_FONT_ID : UI_12_FONT_ID;
+  const int lh = r.getLineHeight(font);
+  const int qw = r.getTextWidth(font, "?", EpdFontFamily::BOLD);
+  r.fillRect(cx - qw / 2 - 4, cy - lh / 2 - 2, qw + 8, lh + 4, false);
+  r.drawText(font, cx - qw / 2, cy - lh / 2, "?", true, EpdFontFamily::BOLD);
+}
+
+void character(const GfxRenderer& r, const uint8_t id, const int x, const int y, const int size) {
+  const Character& c = olympus::character(id);
+  if (const Sprite* art = sprites::characterArt(c.key)) {
+    sprite(r, *art, x, y, size);
+    return;
+  }
+  // No art yet: a light figure carrying the initial.
+  const auto u = [size](const int v) { return v * size / 96; };
+  for (int dy = 0; dy < size; ++dy) {
+    for (int dx = 0; dx < size; ++dx) {
+      const float fx = dx * 96.0f / size;
+      const float fy = dy * 96.0f / size;
+      const float hx = (fx - 48) / 28, hy = (fy - 33) / 27;
+      const bool head = hx * hx + hy * hy <= 1.0f;
+      const bool body = fy >= 56 && fy <= 86 && std::fabs(fx - 48) <= 14 + (fy - 56) * 8 / 30;
+      if (head || body) plotTone(r, x + dx, y + dy, 2);
+    }
+  }
+  const int cx = x + u(48), cy = y + u(33);
+  ring(r, cx, cy, u(28), std::max(2, size / 48));
+  const char initial[3] = {c.name[0], 0, 0};
+  const int font = size >= 120 ? NOTOSANS_18_FONT_ID : UI_12_FONT_ID;
+  const int lh = r.getLineHeight(font);
+  const int w = r.getTextWidth(font, initial, EpdFontFamily::BOLD);
+  r.fillRect(cx - w / 2 - 4, cy - lh / 2 - 2, w + 8, lh + 4, false);
+  r.drawText(font, cx - w / 2, cy - lh / 2, initial, true, EpdFontFamily::BOLD);
+}
+
+void egg(const GfxRenderer& r, const Tier tier, const int stage, const bool cold, const int x, const int y,
+         const int size) {
+  const int index = cold ? 5 : std::clamp(stage, 0, 4);
+  sprite(r, *sprites::eggs[static_cast<int>(tier)][index], x, y, size);
+}
+
+void logo(const GfxRenderer& r, const int x, const int y, const int size) {
+  sprite(r, size <= 48 ? sprites::spr_logo_icon_44 : sprites::spr_logo_96, x, y, size);
+}
+
+void meander(const GfxRenderer& r, const int y, const int x0, const int x1) {
+  constexpr int h = 10;
+  for (int x = x0; x + h <= x1; x += 2 * h) {
+    r.fillRect(x, y, 2, h + 1, true);          // up
+    r.fillRect(x, y, h + 1, 2, true);          // across
+    r.fillRect(x + h, y, 2, h + 1, true);      // down
+    r.fillRect(x + h, y + h - 1, h + 1, 2, true);  // along the bottom to the next unit
+  }
+}
+
+void bar(const GfxRenderer& r, const int x, const int y, const int w, const int h, const int perMille) {
+  r.drawRect(x, y, w, h, 2, true);
+  const int fill = (w - 6) * std::clamp(perMille, 0, 1000) / 1000;
+  if (fill > 0) r.fillRect(x + 3, y + 3, fill, h - 6, true);
+  for (const int q : {250, 500, 750}) r.fillRect(x + w * q / 1000 - 1, y + h + 2, 2, 5, true);
+}
+
+int pill(const GfxRenderer& r, const int fontId, const int x, const int y, const char* text, const bool inverted) {
+  const int tw = r.getTextWidth(fontId, text, EpdFontFamily::BOLD);
+  const int h = r.getLineHeight(fontId) + 6;
+  const int w = tw + 16;
+  if (inverted) {
+    r.fillRect(x, y, w, h, false);
+    r.drawRoundedRect(x, y, w, h, 2, h / 2, true);
+  } else {
+    r.fillRoundedRect(x, y, w, h, h / 2, Color::Black);
+  }
+  r.drawText(fontId, x + 8, y + 3, text, inverted, EpdFontFamily::BOLD);
+  return w;
+}
+
+int wrap(const GfxRenderer& r, const int fontId, const int x, const int y, const int w, const char* text,
+         const int maxLines, const bool black, const bool bold) {
+  const auto style = bold ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR;
+  const int lh = r.getLineHeight(fontId);
+  int yy = y;
+  for (const auto& line : r.wrappedText(fontId, text, w, maxLines, style)) {
+    r.drawText(fontId, x, yy, line.c_str(), black, style);
+    yy += lh;
+  }
+  return yy;
+}
+
+void centered(const GfxRenderer& r, const int fontId, const int cx, const int y, const char* text, const bool black,
+              const bool bold) {
+  const auto style = bold ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR;
+  r.drawText(fontId, cx - r.getTextWidth(fontId, text, style) / 2, y, text, black, style);
+}
+
+const char* tierEggName(const Tier tier) {
+  const char* const names[] = {OLY_T("Trứng đất sét", "Clay egg"), OLY_T("Trứng bạc", "Silver egg"), OLY_T("Trứng vàng", "Gold egg")};
+  return names[static_cast<int>(tier)];
+}
+const char* tierUpperName(const Tier tier) {
+  const char* const names[] = {OLY_T("TRỨNG ĐẤT SÉT", "CLAY EGG"), OLY_T("TRỨNG BẠC", "SILVER EGG"), OLY_T("TRỨNG VÀNG", "GOLD EGG")};
+  return names[static_cast<int>(tier)];
+}
+const char* tierShortName(const Tier tier) {
+  const char* const names[] = {OLY_T("Đất sét", "Clay"), OLY_T("Bạc", "Silver"), OLY_T("Vàng", "Gold")};
+  return names[static_cast<int>(tier)];
+}
+const char* tierKind(const Tier tier) {
+  const char* const names[] = {OLY_T("Sinh vật", "Creature"), OLY_T("Thần", "God"), "Titan"};
+  return names[static_cast<int>(tier)];
+}
+const char* tierBookRange(const Tier tier) {
+  const char* const names[] = {OLY_T("0 đến 200 trang", "0 to 200 pages"), OLY_T("201 đến 499 trang", "201 to 499 pages"), OLY_T("từ 500 trang", "500+ pages")};
+  return names[static_cast<int>(tier)];
+}
+
+std::string number(const uint8_t id) {
+  char buf[8];
+  snprintf(buf, sizeof(buf), "#%03d", indexInTier(id) + 1);
+  return buf;
+}
+
+// ---------------- Status / sleep screen ----------------
+
+namespace {
+void frame(const GfxRenderer& r) {
+  r.drawRect(10, 34, W - 20, 756, 3, true);
+  meander(r, 44, 20, W - 20);
+  meander(r, 766, 20, W - 20);
+}
+
+void incubatorRow(const GfxRenderer& r, const State& s, const int y, const bool big) {
+  const int eggSize = big ? 96 : 48;
+  const int step = big ? 120 : 130;
+  const int x0 = big ? 60 : 36;
+  for (int i = 0; i < SLOT_COUNT; ++i) {
+    const Slot& slot = s.slots[i];
+    const int x = x0 + i * step;
+    char pct[16];
+    if (slot.used) {
+      const int stage = crackStage(slot.readPages, slot.pages);
+      egg(r, slot.tier, stage, store().isColdEgg(i), x, y, eggSize);
+      snprintf(pct, sizeof(pct), "%d%%", slot.pages ? slot.readPages * 100 / slot.pages : 0);
+    } else {
+      ring(r, x + eggSize / 2, y + eggSize / 2, eggSize / 3, 2);
+      r.fillRect(x + eggSize / 2 - eggSize / 8, y + eggSize / 2 - 1, eggSize / 4, 3, true);
+      r.fillRect(x + eggSize / 2 - 1, y + eggSize / 2 - eggSize / 8, 3, eggSize / 4, true);
+      snprintf(pct, sizeof(pct), OLY_T("Trống", "Empty"));
+    }
+    if (big) {
+      centered(r, UI_12_FONT_ID, x + eggSize / 2, y + eggSize + 6, pct, true, true);
+    } else {
+      r.drawText(UI_10_FONT_ID, x + eggSize + 6, y + eggSize / 2 - r.getLineHeight(UI_10_FONT_ID) / 2, pct, true,
+                 EpdFontFamily::BOLD);
+    }
+  }
+}
+
+// English only: "1 days" reads wrong, so make it "1 day".
+void singularDays(char* text) {
+  if (!english()) return;
+  for (char* p = strstr(text, "1 days"); p; p = strstr(p + 1, "1 days")) {
+    if (p != text && p[-1] >= '0' && p[-1] <= '9') continue;
+    memmove(p + 5, p + 6, strlen(p + 6) + 1);
+  }
+}
+
+void goalPanel(const GfxRenderer& r, const State& s, const int y) {
+  const Companion& c = s.companion;
+  const Tier tier = tierOf(c.charId);
+  const int goal = dailyGoal(tier);
+  r.drawRoundedRect(28, y, W - 56, 132, 2, 10, true);
+  r.drawText(SMALL_FONT_ID, 44, y + 12, OLY_T("MỤC TIÊU HÔM NAY", "TODAY'S GOAL"), true, EpdFontFamily::BOLD);
+  char buf[48];
+  snprintf(buf, sizeof(buf), OLY_T("%d/%d trang", "%d/%d pages"), std::min<int>(c.todayPages, 999), goal);
+  const int bw = r.getTextWidth(UI_12_FONT_ID, buf, EpdFontFamily::BOLD);
+  r.drawText(UI_12_FONT_ID, W - 44 - bw, y + 8, buf, true, EpdFontFamily::BOLD);
+  bar(r, 44, y + 38, W - 88, 16, c.todayPages * 1000 / goal);
+  snprintf(buf, sizeof(buf), OLY_T("Chỉ tính sách %s", "Only books of %s count"), tierBookRange(tier));
+  r.drawText(SMALL_FONT_ID, 44, y + 66, buf);
+  const char* missedLabel = OLY_T("Ngày lỡ", "Missed days");
+  r.drawText(SMALL_FONT_ID, 44, y + 98, missedLabel, true, EpdFontFamily::BOLD);
+  const int dotsX = std::max(120, 44 + r.getTextWidth(SMALL_FONT_ID, missedLabel, EpdFontFamily::BOLD) + 20);
+  const int missed = c.goalMetToday ? 0 : c.missed;
+  for (int i = 0; i < MAX_MISSED_DAYS; ++i) {
+    const int cx = dotsX + i * 24, cy = y + 106;
+    if (i < missed) {
+      fillCircle(r, cx, cy, 8);
+    } else {
+      ring(r, cx, cy, 8, 2);
+    }
+  }
+  if (tier == Tier::Clay) {
+    snprintf(buf, sizeof(buf), OLY_T("Chuỗi nuôi: %d ngày", "Fed streak: %d days"), c.streak);
+  } else if (c.ember) {
+    snprintf(buf, sizeof(buf), OLY_T("Đuốc: than tàn", "Torch: embers"));
+  } else {
+    snprintf(buf, sizeof(buf), OLY_T("Đuốc cháy %d ngày", "Torch lit %d days"), c.streak);
+  }
+  singularDays(buf);
+  const int sw = r.getTextWidth(SMALL_FONT_ID, buf, EpdFontFamily::BOLD);
+  r.drawText(SMALL_FONT_ID, W - 44 - sw, y + 98, buf, true, EpdFontFamily::BOLD);
+}
+
+// A speech bubble (white) or a warning box (black) under the character.
+void message(const GfxRenderer& r, const int y, const char* text, const bool warning) {
+  // English sentences run longer, so give them a fourth line.
+  const int lines = english() ? 4 : 3;
+  const int h = english() ? 116 : 92;
+  if (warning) {
+    r.fillRoundedRect(28, y, W - 56, h, 12, Color::Black);
+  } else {
+    r.drawRoundedRect(28, y, W - 56, h, 2, 14, true);
+    // Tail pointing at the character.
+    for (int i = 0; i < 16; ++i) r.fillRect(232 - i / 2, y - 16 + i, 2 + i, 1, true);
+    for (int i = 2; i < 16; ++i) r.fillRect(234 - i / 2, y - 14 + i, i - 2, 1, false);
+  }
+  wrap(r, UI_10_FONT_ID, 48, y + 12, W - 96, text, lines, !warning, warning);
+}
+
+void phase1Screen(const GfxRenderer& r, const State& s) {
+  const uint8_t id = s.sleepChar;
+  if (id != NO_CHAR && s.isHatched(id)) {
+    character(r, id, (W - 288) / 2, 150, 288);
+    centered(r, NOTOSANS_18_FONT_ID, W / 2, 448, olympus::character(id).name, true, true);
+    const std::string sub = number(id) + OLY_T(" · ", " · ") + tierEggName(tierOf(id));
+    centered(r, SMALL_FONT_ID, W / 2, 500, sub.c_str());
+    return;
+  }
+  centered(r, NOTOSANS_18_FONT_ID, W / 2, 150, OLY_T("Lò ấp", "Incubator"), true, true);
+  centered(r, SMALL_FONT_ID, W / 2, 204, OLY_T("Chưa có nhân vật nào nở", "No character has hatched yet"));
+  incubatorRow(r, s, 260, true);
+  wrap(r, UI_10_FONT_ID, 48, 420, W - 96,
+       OLY_T("Đọc xong một cuốn trong lò ấp để nở nhân vật đầu tiên. Sau đó vào Đền thờ để chọn nhân vật cho màn hình chờ.", "Finish a book in the incubator to hatch your first character. Then visit the Temple to choose one for your sleep screen."),
+       4);
+}
+
+void leftScreen(const GfxRenderer& r, const State& s) {
+  // Same layout as the companion screen, with the temple the creature went back to in its place.
+  const uint8_t id = s.companion.leftCharId;
+  const char* name = olympus::character(id).name;
+  char buf[240];
+  snprintf(buf, sizeof(buf), OLY_T("%s đã về Đền thờ", "%s went back to the Temple"), name);
+  centered(r, UI_10_FONT_ID, W / 2, 104, buf);
+  logo(r, (W - 240) / 2, 180, 240);
+  r.fillRect(60, 440, W - 120, 2, true);
+  snprintf(buf, sizeof(buf), OLY_T("%d ngày liền chưa đọc đủ %d trang nên %s đã về Đền thờ. Vào Đền thờ để chọn lại %s nhé.", "%d days in a row without reading %d pages, so %s went back to the Temple. Visit the Temple to choose %s again."),
+           MAX_MISSED_DAYS, dailyGoal(Tier::Clay), name, name);
+  message(r, 470, buf, false);
+  const int pw = r.getTextWidth(UI_10_FONT_ID, OLY_T("Bật máy · vào Đền thờ", "Wake up · visit the Temple"), EpdFontFamily::BOLD) + 16;
+  pill(r, UI_10_FONT_ID, (W - pw) / 2, 640, OLY_T("Bật máy · vào Đền thờ", "Wake up · visit the Temple"));
+}
+
+void companionScreen(const GfxRenderer& r, const State& s) {
+  const Companion& c = s.companion;
+  const Character& ch = olympus::character(c.charId);
+  const Tier tier = tierOf(c.charId);
+  const Mood mood = companionMood(s);
+  const int goal = dailyGoal(tier);
+  char label[96];
+  char text[240];
+  bool warning = false;
+  switch (mood) {
+    case Mood::Happy:
+      snprintf(label, sizeof(label), c.todayPages >= goal ? OLY_T("%s đang chơi đùa", "%s is playing") : OLY_T("%s đang chờ bữa ăn", "%s is waiting for a meal"), ch.name);
+      break;
+    case Mood::Hungry:
+      snprintf(label, sizeof(label), OLY_T("%s đói bụng", "%s is hungry"), ch.name);
+      break;
+    case Mood::Blessing:
+      snprintf(label, sizeof(label), OLY_T("Đuốc của %s đang cháy", "%s's torch is burning"), ch.name);
+      break;
+    case Mood::WeakTorch:
+      snprintf(label, sizeof(label), OLY_T("Đuốc của %s cháy yếu", "%s's torch is flickering"), ch.name);
+      break;
+    default:
+      snprintf(label, sizeof(label), OLY_T("Đuốc của %s đã thành than", "%s's torch has burned out"), ch.name);
+      break;
+  }
+  centered(r, UI_10_FONT_ID, W / 2, 104, label);
+  character(r, c.charId, (W - 288) / 2, 140, 288);
+
+  if (tier == Tier::Clay) {
+    // Meadow line under the creature; it is fed once today's goal is read.
+    r.fillRect(60, 440, W - 120, 2, true);
+    if (c.todayPages >= goal) {
+      snprintf(text, sizeof(text), OLY_T("No căng bụng rồi! Hôm nay %s đã được ăn.", "All full! %s has been fed today."), ch.name);
+    } else if (mood == Mood::Hungry) {
+      warning = true;
+      const int left = MAX_MISSED_DAYS - c.missed;
+      if (left > 1) {
+        snprintf(text, sizeof(text), OLY_T("Đã lỡ %d ngày. Còn %d ngày để đọc %d trang sách %s, nếu không %s sẽ bỏ về đền.", "%d days missed. %d days left to read %d pages from books of %s, or %s will go back to the Temple."),
+                 c.missed, left, goal, tierBookRange(tier), ch.name);
+      } else {
+        snprintf(text, sizeof(text), OLY_T("Đã lỡ %d ngày. Đọc %d trang sách %s hôm nay, nếu không %s sẽ bỏ về đền.", "%d days missed. Read %d pages from books of %s today, or %s will go back to the Temple."),
+                 c.missed, goal, tierBookRange(tier), ch.name);
+      }
+    } else {
+      snprintf(text, sizeof(text), OLY_T("Hôm nay %s chưa được ăn. Đọc đủ %d trang để cho nó ăn nhé.", "%s has not eaten today. Read %d pages to feed it."), ch.name, goal);
+    }
+  } else {
+    const int level = mood == Mood::Ember ? 0 : (mood == Mood::WeakTorch ? 1 : 2);
+    sprite(r, *sprites::flames[level], 360, 340, 96);
+    r.fillRect(80, 436, W - 160, 2, true);
+    if (mood == Mood::Ember) {
+      warning = true;
+      snprintf(text, sizeof(text), OLY_T("%s đang giận, không ban phước. Đọc %d trang sách %s để thắp lại đuốc.", "%s is angry and gives no blessing. Read %d pages from books of %s to relight the torch."), ch.name,
+               goal, tierBookRange(tier));
+    } else if (mood == Mood::WeakTorch) {
+      warning = true;
+      snprintf(text, sizeof(text), OLY_T("Đã lỡ %d ngày. Đọc %d trang sách %s hôm nay, nếu không đuốc sẽ thành than.", "%d days missed. Read %d pages from books of %s today, or the torch will burn out."),
+               c.missed, goal, tierBookRange(tier));
+    } else {
+      snprintf(text, sizeof(text), OLY_T("“%s”", "\"%s\""), ch.blessing);
+    }
+  }
+  singularDays(text);
+  message(r, 476, text, warning);
+  goalPanel(r, s, 606);
+  if (Store::today() == NO_DAY) {
+    centered(r, SMALL_FONT_ID, W / 2, 738, OLY_T("Đồng hồ chưa có giờ: chưa đếm được ngày", "Clock not set: days cannot be counted yet"));
+  }
+}
+}  // namespace
+
+void statusScreen(const GfxRenderer& r, const bool forSleep) {
+  Store& st = store();
+  st.refreshDay();
+  const State& s = st.state();
+  frame(r);
+  // The companion screen (feeding / torch) shows in both phases once a character is on the sleep screen.
+  if (s.companion.charId != NO_CHAR) {
+    companionScreen(r, s);
+  } else if (s.companion.leftCharId != NO_CHAR) {
+    leftScreen(r, s);
+  } else if (!s.phase2()) {
+    if (forSleep) centered(r, SMALL_FONT_ID, W / 2, 70, OLY_T("Bấm nút nguồn để đọc tiếp", "Press the power button to keep reading"));
+    phase1Screen(r, s);
+  } else {
+    centered(r, NOTOSANS_18_FONT_ID, W / 2, 300, OLY_T("Đã đủ 90/90", "All 90/90 collected"), true, true);
+    wrap(r, UI_10_FONT_ID, 60, 360, W - 120,
+         OLY_T("Lò ấp đã đóng. Vào Olympus, mở hồ sơ một nhân vật trong Đền thờ và chạm Đặt làm màn chờ để nhận bạn đồng hành.", "The Incubator is closed. Open Olympus, open a character profile in the Temple and tap Set as sleep screen to get a companion."), 4);
+  }
+}
+
+}  // namespace olympus::draw
diff --git a/src/olympus/OlympusDraw.h b/src/olympus/OlympusDraw.h
new file mode 100644
index 00000000..0a24c4b9
--- /dev/null
+++ b/src/olympus/OlympusDraw.h
@@ -0,0 +1,44 @@
+#pragma once
+// Drawing helpers shared by the Olympus screens and the sleep screen.
+#include <cstdint>
+#include <string>
+
+#include "OlympusRules.h"
+#include "OlympusSprite.h"
+
+class GfxRenderer;
+
+namespace olympus::draw {
+
+// 4-tone sprite scaled (nearest neighbour) into a size x size square; grays
+// are dithered, white is transparent.
+void sprite(const GfxRenderer& r, const Sprite& s, int x, int y, int size);
+// Character art, or a placeholder figure when the character has no art yet.
+void character(const GfxRenderer& r, uint8_t id, int x, int y, int size);
+// Dark "?" figure for a character not hatched yet.
+void silhouette(const GfxRenderer& r, int x, int y, int size);
+void egg(const GfxRenderer& r, Tier tier, int stage, bool cold, int x, int y, int size);
+void logo(const GfxRenderer& r, int x, int y, int size);
+// Greek key band, 10 px high.
+void meander(const GfxRenderer& r, int y, int x0, int x1);
+// Progress bar with quarter ticks; frac in 0..1000 per mille.
+void bar(const GfxRenderer& r, int x, int y, int w, int h, int perMille);
+// Black rounded label with white text; returns its width.
+int pill(const GfxRenderer& r, int fontId, int x, int y, const char* text, bool inverted = false);
+// Word-wrapped text; returns the y below the last line.
+int wrap(const GfxRenderer& r, int fontId, int x, int y, int w, const char* text, int maxLines, bool black = true,
+         bool bold = false);
+void centered(const GfxRenderer& r, int fontId, int cx, int y, const char* text, bool black = true, bool bold = false);
+
+const char* tierEggName(Tier tier);    // "Trứng đất sét"
+const char* tierUpperName(Tier tier);  // "TRỨNG ĐẤT SÉT"
+const char* tierShortName(Tier tier);  // "Đất sét"
+const char* tierKind(Tier tier);       // "Sinh vật", "Thần", "Titan"
+const char* tierBookRange(Tier tier);  // "0 đến 200 trang"
+std::string number(uint8_t id);        // "#003"
+
+// The companion / incubator screen drawn on sleep and by the companion tile.
+// forSleep adds the "press power" line and suits a full refresh.
+void statusScreen(const GfxRenderer& r, bool forSleep);
+
+}  // namespace olympus::draw
