+void OlympusActivity::renderTemple() {
+  const auto& s = olympus::store().state();
+  const bool phase2 = s.phase2();
+  renderer.drawText(olympus::fonts::TITLE, 24, 16, OLY_T("Đền thờ", "Temple"), true, EpdFontFamily::BOLD);
+  char buf[64];
+  snprintf(buf, sizeof(buf), "%d/90", s.totalHatched());
+  const int tw = renderer.getTextWidth(UI_12_FONT_ID, buf, EpdFontFamily::BOLD);
+  renderer.drawText(UI_12_FONT_ID, W - 24 - tw, 24, buf, true, EpdFontFamily::BOLD);
+
+  for (int t = 0; t < olympus::TIER_COUNT; ++t) {
+    const auto tier = static_cast<Tier>(t);
+    snprintf(buf, sizeof(buf), "%s %d/30", draw::tierShortName(tier), s.hatchedCount(tier));
+    const int x = 24 + t * 148;
+    const bool active = t == templeTab;
+    if (active) {
+      renderer.fillRoundedRect(x, 66, 140, 34, 8, Color::Black);
+    } else {
+      renderer.drawRoundedRect(x, 66, 140, 34, 2, 8, true);
+    }
+    draw::centered(renderer, UI_10_FONT_ID, x + 70, 72, buf, !active, true);
+  }
+  draw::bar(renderer, 24, 108, W - 48, 10, s.hatchedCount(static_cast<Tier>(templeTab)) * 1000 / PER_TIER);
+
+  const int page = templeIndex / GRID_PER_PAGE;
+  const int first = page * GRID_PER_PAGE;
+  const int last = std::min(PER_TIER, first + GRID_PER_PAGE);
+  for (int i = first; i < last; ++i) {
+    const auto id = static_cast<uint8_t>(templeTab * PER_TIER + i);
+    const int cell = i - first;
+    const int x = 24 + (cell % GRID_COLS) * 110;
+    const int y = 132 + (cell / GRID_COLS) * 146;
+    const bool selected = i == templeIndex;
+    renderer.drawRoundedRect(x, y, 104, 138, selected ? 4 : 1, 8, true);
+    const std::string num = draw::number(id);
+    renderer.drawText(SMALL_FONT_ID, x + 6, y + 4, num.c_str());
+    const bool hatched = s.isHatched(id);
+    if (hatched) {
+      draw::character(renderer, id, x + 12, y + 24, 80);
+    } else {
+      draw::silhouette(renderer, x + 12, y + 24, 80);
+    }
+    const std::string name = hatched ? renderer.truncatedText(SMALL_FONT_ID, olympus::character(id).name, 96,
+                                                              EpdFontFamily::BOLD)
+                                     : std::string("???");
+    draw::centered(renderer, SMALL_FONT_ID, x + 52, y + 108, name.c_str(), true, true);
+    if (s.isFresh(id)) {
+      const int pw = renderer.getTextWidth(SMALL_FONT_ID, OLY_T("MỚI", "NEW"), EpdFontFamily::BOLD) + 16;
+      draw::pill(renderer, SMALL_FONT_ID, x + 104 - pw - 4, y + 4, OLY_T("MỚI", "NEW"));
+    }
+  }
+  // Touch boards swipe up/down between the two pages and tap the tabs, so no page line there.
+  if (!mappedInput.hasTouch()) {
+    const int pages = (PER_TIER + GRID_PER_PAGE - 1) / GRID_PER_PAGE;
+    if (page + 1 < pages) {
+      snprintf(buf, sizeof(buf), OLY_T("Trang %d/%d · xuống để xem #%03d-#%03d", "Page %d/%d · down for #%03d-#%03d"), page + 1, pages, last + 1, PER_TIER);
+    } else {
+      snprintf(buf, sizeof(buf), OLY_T("Trang %d/%d · giữ trái/phải để đổi tab", "Page %d/%d · hold left/right to switch tab"), page + 1, pages);
+    }
+    draw::centered(renderer, SMALL_FONT_ID, W / 2, 722, buf);
+  }
+  drawHints(OLY_T("Quay lại", "Back"), phase2 ? OLY_T("Hồ sơ", "Profile") : OLY_T("Xem hồ sơ", "View profile"), OLY_T("Trái", "Left"), OLY_T("Phải", "Right"));
+}
