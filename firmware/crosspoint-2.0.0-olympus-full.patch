+
+void frame(const GfxRenderer& r) {
+  r.drawRect(10, 34, W - 20, 756, 3, true);
+  meander(r, 44, 20, W - 20);
+  meander(r, 766, 20, W - 20);
+}
+
+// Dithered fill: tone 1 dark gray, 2 light gray (see plotTone).
+void fillTone(const GfxRenderer& r, const int x, const int y, const int w, const int h, const uint8_t tone) {
+  for (int dy = 0; dy < h; ++dy)
+    for (int dx = 0; dx < w; ++dx) plotTone(r, x + dx, y + dy, tone);
+}
+
+// Character art drawn one tone lighter: the creature that left is only a memory.
+void spriteFaded(const GfxRenderer& r, const Sprite& s, const int x, const int y, const int size) {
+  for (int dy = 0; dy < size; ++dy) {
+    const int sy = dy * s.height / size;
+    for (int dx = 0; dx < size; ++dx) {
+      const uint8_t t = s.tone(dx * s.width / size, sy);
+      plotTone(r, x + dx, y + dy, t >= 3 ? 3 : static_cast<uint8_t>(t + 1));
+    }
+  }
+}
+
+// A light stone slab with a black outline.
+void slab(const GfxRenderer& r, const int x, const int y, const int w, const int h) {
+  r.fillRect(x, y, w, h, false);
+  fillTone(r, x, y, w, h, 2);
+  r.drawRect(x, y, w, h, 2, true);
+}
+
+// Vertical flutes on a stone face, leaving a clear band in the middle for a name.
+void flutes(const GfxRenderer& r, const int x, const int y, const int w, const int h, const int clearW) {
+  const int cx = x + w / 2;
+  for (int fx = x + 8; fx < x + w - 6; fx += 10) {
+    if (clearW > 0 && fx > cx - clearW / 2 - 6 && fx < cx + clearW / 2 + 4) continue;
+    fillTone(r, fx, y + 4, 2, h - 8, 1);
+  }
+}
+
+// Stone face with flutes and a name in Cormorant SC, centred.
+void namedStone(const GfxRenderer& r, const int x, const int y, const int w, const int h, const char* name) {
+  slab(r, x, y, w, h);
+  int font = F::NAME;
+  if (r.getTextWidth(font, name, EpdFontFamily::BOLD) > w - 24) font = F::LABEL;
+  const int tw = r.getTextWidth(font, name, EpdFontFamily::BOLD);
+  const int bandW = tw + 20;
+  r.fillRect(x + w / 2 - bandW / 2, y + 2, bandW, h - 4, false);
+  fillTone(r, x + w / 2 - bandW / 2, y + 2, bandW, h - 4, 2);
+  flutes(r, x, y, w, h, bandW);
+  // Clear the band behind the letters so they stay sharp.
+  r.fillRect(x + w / 2 - tw / 2 - 4, y + 4, tw + 8, h - 8, false);
+  const int lh = r.getLineHeight(font);
+  r.drawText(font, x + w / 2 - tw / 2, y + (h - lh) / 2, name, true, EpdFontFamily::BOLD);
+}
+
+// Faint temple front around the scene: pediment, entablature, two columns and a step.
+constexpr int FACADE_X0 = 24, FACADE_X1 = W - 24;
+constexpr int ROOF_TOP = 58, ROOF_BASE = 94, ENTABLATURE = 110;
+void facade(const GfxRenderer& r, const int bottom) {
+  const int w = FACADE_X1 - FACADE_X0;
+  // Pediment, outlined in light gray.
+  for (int y = ROOF_TOP; y < ROOF_BASE; ++y) {
+    const int half = (y - ROOF_TOP) * (w / 2) / (ROOF_BASE - ROOF_TOP);
+    fillTone(r, W / 2 - half, y, 3, 1, 1);
+    fillTone(r, W / 2 + half - 3, y, 3, 1, 1);
+  }
+  fillTone(r, FACADE_X0, ROOF_BASE, w, 2, 1);
+  // Entablature with dentils.
+  fillTone(r, FACADE_X0, ENTABLATURE - 2, w, 2, 1);
+  for (int x = FACADE_X0 + 10; x + 8 < FACADE_X1; x += 18) fillTone(r, x, ROOF_BASE + 5, 8, 7, 1);
+  // Columns with flutes.
+  for (const int cx : {FACADE_X0 + 2, FACADE_X1 - 24}) {
+    fillTone(r, cx, ENTABLATURE, 2, bottom - ENTABLATURE, 1);
+    fillTone(r, cx + 20, ENTABLATURE, 2, bottom - ENTABLATURE, 1);
+    for (int fx = cx + 6; fx < cx + 20; fx += 6) fillTone(r, fx, ENTABLATURE + 4, 1, bottom - ENTABLATURE - 8, 2);
+  }
+  // Step.
+  fillTone(r, FACADE_X0 - 4, bottom, w + 8, 2, 1);
+  fillTone(r, FACADE_X0 - 4, bottom + 8, w + 8, 2, 1);
+}
+
+constexpr int SCENE_TOP = 154;    // below the label
+constexpr int SCENE_BOTTOM = 444; // the facade step
+
+// Upper-case copy of an ASCII name (character names are Latin).
+std::string upper(const char* s) {
+  std::string out(s);
+  for (auto& c : out) if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+  return out;
+}
+
+// God or Titan between two torch pillars, standing on a named plinth.
+void shrine(const GfxRenderer& r, const uint8_t id, const int level) {
+  constexpr int A = 212;
+  const int cx = W / 2;
+  const int artY = SCENE_TOP;
+  const int feet = artY + A * 97 / 100;
+  // Pillars with braziers.
+  const int flameL = level == 2 ? 2 : (level == 1 ? 1 : 0);
+  const int flameR = level == 2 ? 2 : 0;
+  for (int side = 0; side < 2; ++side) {
+    const int pc = side == 0 ? cx - A / 2 - 46 : cx + A / 2 + 46;
+    const int top = 262;
+    slab(r, pc - 13, top, 26, SCENE_BOTTOM - 10 - top);
+    flutes(r, pc - 13, top, 26, SCENE_BOTTOM - 10 - top, 0);
+    slab(r, pc - 21, top - 10, 42, 10);
+    slab(r, pc - 21, SCENE_BOTTOM - 12, 42, 10);
+    sprite(r, *sprites::flames[side == 0 ? flameL : flameR], pc - 36, top - 10 - 66, 72);
+  }
+  character(r, id, cx - A / 2, artY, A);
+  // Plinth: cap, named body, base.
+  slab(r, cx - 100, feet, 200, 10);
+  namedStone(r, cx - 88, feet + 10, 176, 54, upper(olympus::character(id).name).c_str());
+  slab(r, cx - 108, feet + 64, 216, 10);
+}
+
+// Creature behind its offering stone, with the bowl on the left of the ledge.
+// state: 0 fed (full bowl), 1 waiting / hungry (empty bowl), 2 left (tipped bowl, cracked stone, faded creature).
+void altar(const GfxRenderer& r, const uint8_t id, const int state) {
+  constexpr int A = 224;
+  const int cx = W / 2;
+  const int topY = SCENE_TOP + A * 90 / 100;
+  const int sw = A * 156 / 100;
+  if (state == 2) {
+    if (const Sprite* art = sprites::characterArt(olympus::character(id).key)) {
+      spriteFaded(r, *art, cx - A / 2, SCENE_TOP, A);
+    } else {
+      character(r, id, cx - A / 2, SCENE_TOP, A);
+    }
+  } else {
+    character(r, id, cx - A / 2, SCENE_TOP, A);
+  }
+  const int bodyW = A * 140 / 100, bodyH = 54;
+  slab(r, cx - sw / 2, topY, sw, 10);
+  const std::string name = upper(olympus::character(id).name);
+  namedStone(r, cx - bodyW / 2, topY + 10, bodyW, bodyH, name.c_str());
+  slab(r, cx - A * 160 / 200, topY + 10 + bodyH, A * 160 / 100, 10);
+  if (state == 2) {
+    // Zigzag crack down the left of the stone.
+    int x = cx - bodyW / 2 + bodyW * 18 / 100;
+    for (int y = topY; y < topY + 10 + bodyH; y += 9) {
+      const int nx = x + (((y - topY) / 9) % 2 == 0 ? 6 : -6);
+      for (int t = 0; t < 9; ++t) r.fillRect(x + (nx - x) * t / 9 - 1, y + t, 3, 1, true);
+      x = nx;
+    }
+  }
+  const int it = A * 30 / 100;
+  const int bowlX = cx - sw / 2 + sw * 4 / 100;
+  const int bowlY = topY - (state == 2 ? it : it * 88 / 96);
+  sprite(r, *sprites::bowls[state], bowlX, bowlY, it);
+}
+
+void incubatorRow(const GfxRenderer& r, const State& s, const int y, const bool big) {
+  const int eggSize = big ? 96 : 48;
+  const int step = big ? 120 : 130;
+  const int x0 = big ? 60 : 36;
+  for (int i = 0; i < SLOT_COUNT; ++i) {
+    const Slot& slot = s.slots[i];
+    const int x = x0 + i * step;
+    char pct[16];
+    if (slot.used) {
+      const int stage = crackStage(slot.readPages, slot.pages);
+      egg(r, slot.tier, stage, store().isColdEgg(i), x, y, eggSize);
+      snprintf(pct, sizeof(pct), "%d%%", slot.pages ? slot.readPages * 100 / slot.pages : 0);
+    } else {
+      ring(r, x + eggSize / 2, y + eggSize / 2, eggSize / 3, 2);
+      r.fillRect(x + eggSize / 2 - eggSize / 8, y + eggSize / 2 - 1, eggSize / 4, 3, true);
+      r.fillRect(x + eggSize / 2 - 1, y + eggSize / 2 - eggSize / 8, 3, eggSize / 4, true);
+      snprintf(pct, sizeof(pct), OLY_T("Trống", "Empty"));
+    }
+    if (big) {
+      centered(r, F::BODY, x + eggSize / 2, y + eggSize + 6, pct, true, true);
+    } else {
+      r.drawText(F::SMALL, x + eggSize + 6, y + eggSize / 2 - r.getLineHeight(F::SMALL) / 2, pct, true,
+                 EpdFontFamily::BOLD);
+    }
+  }
+}
+
+// English only: "1 days" reads wrong, so make it "1 day".
+void singularDays(char* text) {
+  if (!english()) return;
+  for (char* p = strstr(text, "1 days"); p; p = strstr(p + 1, "1 days")) {
+    if (p != text && p[-1] >= '0' && p[-1] <= '9') continue;
+    memmove(p + 5, p + 6, strlen(p + 6) + 1);
+  }
+}
